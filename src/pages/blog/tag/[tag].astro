---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PublicContentLayout.astro';
import BlogList from '../../../components/blog/BlogList.astro';
import JsonLd from '../../../components/blog/JsonLd.astro';
import { withBase } from '../../../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of (post.data.tags || [])) {
      tagSet.add(tag);
    }
  }
  return Array.from(tagSet).map(t => ({ params: { tag: t } }));
}

const { tag } = Astro.params;

const allPosts = await getCollection('blog');
const filtered = allPosts.filter(post =>
  (post.data.tags || []).includes(tag!)
);

const pageTitle = `标签: ${tag}`;
const pageDesc = `浏览标签为 "${tag}" 的所有文章`;

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDesc,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  showDate={false}
  hidePageHeader={true}
  tags={[]}
>
  <JsonLd slot="head" data={collectionPageLd} />

  <header class="tag-result-header">
    <a href={withBase('/blog/tags/')}>← 返回全部标签</a>
    <span>标签</span><h1>{tag}</h1><p>共 {filtered.length} 篇文章</p>
  </header>
  {
    filtered.length > 0 ? (
      <BlogList posts={filtered} sort="time" />
    ) : (
      <p style="text-align: center; color: var(--foreground-dark);">该标签下暂无文章。</p>
    )
  }
</Layout>
<style>
  .tag-result-header { margin: 16px 0 28px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
  .tag-result-header a { display: inline-block; margin-bottom: 24px; color: var(--accent); font-size: 13px; text-decoration: none; }
  .tag-result-header a:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .tag-result-header > span { display: block; color: var(--text-secondary); font-size: 13px; }
  .tag-result-header h1 { margin: 8px 0 12px; color: var(--text-primary); font-size: clamp(28px, 4vw, 40px); line-height: 1.3; overflow-wrap: anywhere; }
  .tag-result-header p { margin: 0; color: var(--text-secondary); font-size: 14px; }
</style>
