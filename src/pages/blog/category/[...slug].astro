---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PublicContentLayout.astro';
import BlogList from '../../../components/blog/BlogList.astro';
import JsonLd from '../../../components/blog/JsonLd.astro';
import { resolveDirs } from '../../../lib/utils';
import { DIR1_ORDER, DIR2_ORDER, SITE_START_DATE } from '../../../consts';
import { blogCategorySegment, parseBlogCategorySegment, withBase } from '../../../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const pathSet = new Set<string>(DIR1_ORDER.map(blogCategorySegment));
  for (const post of posts) {
    const { dir1, dir2 } = resolveDirs(post);
    if (dir1) {
      const dir1Segment = blogCategorySegment(dir1);
      pathSet.add(dir1Segment);
      if (dir2) pathSet.add(`${dir1Segment}/${blogCategorySegment(dir2)}`);
    }
  }
  return Array.from(pathSet).map(p => ({ params: { slug: p } }));
}

const { slug } = Astro.params;
const categoryPath = slug!;
const segments = categoryPath.split('/');
const filterDir1 = parseBlogCategorySegment(segments[0]);
const filterDir2 = segments.length >= 2 ? parseBlogCategorySegment(segments[1]) : '';

const allPosts = await getCollection('blog');
const filtered = allPosts.filter(post => {
  const { dir1: d1, dir2: d2 } = resolveDirs(post);
  if (filterDir2) return d1 === filterDir1 && d2 === filterDir2;
  return d1 === filterDir1;
});

const pageTitle = filterDir2 ? `分类: ${filterDir1} / ${filterDir2}` : `分类: ${filterDir1}`;
const pageDesc = `浏览 ${pageTitle} 下的所有文章`;
const latestPostDate = filtered.reduce(
  (latest, post) => post.data.pubDate > latest ? post.data.pubDate : latest,
  SITE_START_DATE,
);
const dirOrder = {
  dir1: DIR1_ORDER,
  dir2: DIR2_ORDER,
};

const collectionPageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDesc,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  pubDate={latestPostDate}
  dir1={filterDir1}
  dir2={filterDir2}
  tags={[]}
  showDate={false}
  hidePageHeader={!filterDir2}
>
  <JsonLd slot="head" data={collectionPageLd} />

  {!filterDir2 && (
    <nav class="category-context" aria-label="分类位置">
      <a href={withBase('/blog/')}>← 返回全部分类</a>
      <span>{filtered.length} 篇文章</span>
    </nav>
  )}
  {
    filtered.length > 0 ? (
      filterDir2 ? (
        <BlogList posts={filtered} sort="oldest" />
      ) : (
        <BlogList posts={filtered} sort="dir" dirOrder={dirOrder} />
      )
    ) : (
      <p class="category-empty">该分类下暂无文章。</p>
    )
  }
</Layout>

<style>
  .category-context {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.4rem 0 -0.35rem;
    color: var(--gray);
    font-size: 0.76rem;
  }

  .category-context a {
    color: var(--accent-light);
    font-weight: 680;
    text-decoration: none;
  }

  .category-empty {
    margin: 2rem 0;
    color: var(--gray);
    text-align: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .category-context a:hover {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }
</style>
