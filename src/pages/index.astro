---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, fmtNum } from '../consts';
import { computeSiteStats } from '../lib/blogStats';
import { getRepoLanguages } from '../lib/repoStats';
import { parseMaintenance } from '../lib/maintenance';
import PublicLayout from '../layouts/PublicLayout.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import FormattedDate from '../components/blog/FormattedDate.astro';
import GitHubContributions from '../components/github/GitHubContributions.astro';
import GitHubRepoStats from '../components/github/GitHubRepoStats.astro';
import GitHubLanguages from '../components/github/GitHubLanguages.astro';
import PublicStatus from '../components/home/PublicStatus.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import { blogPostPath, withBase } from '../lib/urls';
import maintenanceSource from '../content/maintenance.md?raw';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: new URL(withBase('/'), Astro.site).href,
};

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stats = computeSiteStats(allPosts);
const { repoLanguages, totalRepoLines } = getRepoLanguages();
const maintenanceEntries = await parseMaintenance(maintenanceSource);
---

<PublicLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <JsonLd slot="head" data={websiteLd} />

  <div class="home-page">
    <section class="home-cover" aria-labelledby="home-title">
      <div class="cover-pattern" aria-hidden="true">
        <span class="cover-ribbon cover-ribbon-one"></span>
        <span class="cover-ribbon cover-ribbon-two"></span>
        <span class="cover-glow cover-glow-one"></span>
        <span class="cover-glow cover-glow-two"></span>
      </div>
      <div class="cover-copy">
        <p class="home-eyebrow">ION MONSTER · PERSONAL NOTES</p>
        <h1 id="home-title">离子怪的博客</h1>
        <p>记录学习、技术与思考的个人博客</p>
      </div>
      <svg class="cover-waves" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
        <path class="cover-wave-back" d="M0 78C180 28 320 48 480 92C650 138 790 142 960 92C1135 41 1265 40 1440 80V180H0Z" />
        <path class="cover-wave-front" d="M0 122C180 78 330 96 500 130C675 165 830 160 1010 118C1190 76 1300 86 1440 112V180H0Z" />
      </svg>
    </section>

    <div class="home-content-layout">
      <aside class="home-profile-card" aria-label="关于离子怪">
        <div class="profile-avatar"><img src={withBase('/avatar.jpg')} alt={`${SITE_AUTHOR} 的头像`} /></div>
        <h2>{SITE_AUTHOR}</h2>
        <p>分享学习过程、技术实践和那些值得慢慢想清楚的事情。</p>
        <SocialLinks showHeaderContacts />
        <dl class="profile-stats" aria-label="博客统计">
          <div><dt>文章</dt><dd>{stats.totalArticles}</dd></div>
          <div><dt>分类</dt><dd>{stats.totalCategories}</dd></div>
          <div><dt>标签</dt><dd>{stats.totalTags}</dd></div>
        </dl>
        <nav class="profile-nav" aria-label="首页快捷导航">
          <a class="profile-nav-active" href={withBase('/')}>⌂ <span>首页</span></a>
          <a href={withBase('/blog/')}>✦ <span>文章</span></a>
          <a href={withBase('/friends/')}>↗ <span>友链</span></a>
          <a href={withBase('/about/')}>◎ <span>关于</span></a>
        </nav>
      </aside>

      <div class="home-main-column">
        <section class="home-intro" aria-label="博客介绍">
          <p class="home-eyebrow">WELCOME</p>
          <h2>你好，我是{SITE_AUTHOR}</h2>
          <p>{SITE_DESCRIPTION} 在这里整理学习路径、技术实践，以及那些值得慢慢想清楚的问题。</p>
          <div class="hero-actions">
            <a class="hero-action primary" href={withBase('/blog/')}>浏览文章</a>
            <a class="hero-action secondary" href={withBase('/about/')}>了解我</a>
          </div>
        </section>

    <section class="recent-section" aria-labelledby="recent-title">
      <header class="section-heading">
        <div>
          <p class="section-kicker">RECENT WRITING</p>
          <h2 id="recent-title">近期文章</h2>
        </div>
        <a class="section-link" href={withBase('/blog/')}>查看全部文章 <span aria-hidden="true">→</span></a>
      </header>

      {recentPosts.length > 0 ? (
        <div class="recent-list">
          {recentPosts.map((post, index) => (
            <article class="home-post-card">
              <a class="home-post-link" href={blogPostPath(post.id)}>
                <div class="home-post-media" style={`--cover-hue:${(338 + index * 48) % 360};`}>
                  {post.data.heroImage ? (
                    <Image src={post.data.heroImage} width={720} height={420} alt={post.data.title} />
                  ) : (
                    <>
                      <span class="cover-grid"></span>
                      <span class="cover-letter">{post.data.dir1?.slice(0, 1) || '文'}</span>
                      <span class="cover-caption">{post.data.dir1 || '个人记录'}</span>
                    </>
                  )}
                </div>
                <div class="home-post-copy">
                  <div class="post-meta-line">
                    <span>{post.data.dir1 || '未分类'}</span>
                    <time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description.replace(/<[^>]+>/g, '')}</p>
                  {post.data.tags.length > 0 && (
                    <div class="post-tags" aria-label="文章标签">
                      {post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                    </div>
                  )}
                  <span class="post-more">继续阅读 <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="home-empty">
          <strong>文章正在整理中</strong>
          <p>这里会展示最近发布的内容。你也可以先进入博客列表查看分类结构。</p>
          <a href={withBase('/blog/')}>浏览博客</a>
        </div>
      )}
    </section>

    <section class="home-info-strip" aria-labelledby="site-info-title">
      <header class="info-strip-heading">
        <div>
          <p class="section-kicker">SITE NOTES</p>
          <h2 id="site-info-title">站点信息</h2>
        </div>
        <p>
          已运行 {stats.daysSinceLaunch} 天 · 累计 {fmtNum(stats.totalWords)} 字 · 仓库 {fmtNum(totalRepoLines)} 行代码
        </p>
      </header>

      <div class="info-strip-grid">
        <section class="info-block language-block" aria-labelledby="language-title">
          <div class="info-block-heading">
            <span>01</span>
            <div><h3 id="language-title">代码语言构成</h3><p>本站仓库与 GitHub 账户</p></div>
          </div>
          <div class="language-grid">
            <GitHubRepoStats languages={repoLanguages} totalLines={totalRepoLines} />
            <GitHubLanguages />
          </div>
        </section>

        <section class="info-block status-block" aria-label="系统状态">
          <div class="info-block-heading">
            <span>02</span>
            <div><h3>运行状态</h3><p>按需检测，不持续轮询</p></div>
          </div>
          <PublicStatus />
        </section>
      </div>

      <div class="info-folds">
        <details class="info-fold maintenance-fold" open>
          <summary><span>03</span><strong>近期维护公告</strong><small>查看最近的功能调整与修复</small></summary>
          <div class="maintenance-list">
            {maintenanceEntries.map((entry, index) => (
              <details class="maintenance-entry" open={index === 0}>
                <summary><time datetime={entry.date}>{entry.date}</time><span>{entry.title}</span></summary>
                <div class="maintenance-body" set:html={entry.html}></div>
              </details>
            ))}
          </div>
        </details>

        <details class="info-fold contribution-fold">
          <summary><span>04</span><strong>GitHub 贡献记录</strong><small>过去一年的公开贡献活跃度</small></summary>
          <div class="contribution-content"><GitHubContributions /></div>
        </details>
      </div>
    </section>
      </div>
    </div>
  </div>
</PublicLayout>

<style>
  .home-page {
    width: 100%;
    margin: 0;
    padding: 0 0 64px;
    overflow: clip;
    color: var(--text-primary);
    text-align: left;
  }

  .home-cover {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 470px;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background:
      linear-gradient(135deg, rgba(24, 29, 69, .9), rgba(113, 45, 93, .76) 48%, rgba(224, 91, 112, .72)),
      radial-gradient(circle at 18% 22%, rgba(255,255,255,.24), transparent 28%),
      linear-gradient(120deg, #343966, #9a506f 58%, #d88483);
  }

  .cover-pattern { position: absolute; inset: 0; z-index: -1; overflow: hidden; opacity: .8; }
  .cover-pattern::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, rgba(0,0,0,.75), transparent 88%); }
  .cover-ribbon { position: absolute; width: 62%; height: 170px; border: 1px solid rgba(255,255,255,.28); border-radius: 50%; transform: rotate(-9deg); filter: blur(.2px); }
  .cover-ribbon-one { top: 42px; left: -10%; }
  .cover-ribbon-two { right: -14%; bottom: 72px; transform: rotate(12deg); }
  .cover-glow { position: absolute; width: 320px; aspect-ratio: 1; border-radius: 50%; filter: blur(55px); opacity: .34; }
  .cover-glow-one { top: -120px; right: 10%; background: #ffb4c3; }
  .cover-glow-two { bottom: -160px; left: 18%; background: #8799ff; }
  .cover-copy { position: relative; z-index: 2; width: min(780px, calc(100% - 32px)); box-sizing: border-box; padding: 32px 24px 96px; text-align: center; text-shadow: 0 3px 24px rgba(12, 12, 30, .32); }
  .home-eyebrow, .section-kicker { margin: 0 0 12px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  .cover-copy .home-eyebrow { color: rgba(255,255,255,.78); }
  .cover-copy h1 { margin: 0; color: #fff; font-size: 48px; line-height: 1.2; letter-spacing: .08em; }
  .cover-copy > p:last-child { margin: 20px 0 0; color: rgba(255,255,255,.86); font-size: 16px; letter-spacing: .08em; }
  .cover-waves { position: absolute; z-index: 3; left: 0; right: 0; bottom: -1px; width: 100%; height: 150px; pointer-events: none; }
  .cover-wave-back { fill: color-mix(in srgb, var(--surface-subtle) 80%, transparent); opacity: .72; transform-origin: center bottom; animation: cover-wave-drift-back 11s ease-in-out infinite alternate; }
  .cover-wave-front { fill: var(--canvas); transform-origin: center bottom; animation: cover-wave-drift-front 7s ease-in-out infinite alternate; }

  .home-content-layout { position: relative; z-index: 4; display: grid; grid-template-columns: 280px minmax(0, 1fr); align-items: start; gap: 40px; width: min(1200px, calc(100% - 48px)); margin: -34px auto 0; }
  .home-main-column { min-width: 0; }
  .home-profile-card { position: sticky; top: 104px; padding: 32px 24px 24px; text-align: center; background: color-mix(in srgb, var(--surface) 96%, transparent); border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 18px 48px color-mix(in srgb, var(--text-primary) 10%, transparent); backdrop-filter: blur(14px); }
  .profile-avatar { display: grid; place-items: center; width: 112px; height: 112px; margin: -68px auto 20px; background: var(--surface); border: 6px solid var(--surface); border-radius: 50%; box-shadow: 0 10px 30px color-mix(in srgb, var(--text-primary) 14%, transparent); }
  .profile-avatar img { width: 100%; height: 100%; border-radius: 50%; }
  .home-profile-card h2 { margin: 0; font-size: 24px; }
  .home-profile-card > p { margin: 12px 0 16px; color: var(--text-secondary); font-size: 14px; line-height: 1.7; }
  .home-profile-card :global(.social-links) { gap: 8px; margin: 0 auto 24px; }
  .home-profile-card :global(.social-links a), .home-profile-card :global(.social-placeholder) { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; color: var(--text-secondary); border-radius: 8px; }
  .home-profile-card :global(.social-links a:hover) { color: var(--accent); background: var(--surface-subtle); }
  .profile-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 0 24px; padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .profile-stats div + div { border-left: 1px solid var(--border); }
  .profile-stats dt { color: var(--text-secondary); font-size: 12px; }
  .profile-stats dd { margin: 4px 0 0; color: var(--text-primary); font-size: 22px; font-weight: 750; line-height: 1.2; }
  .profile-nav { display: grid; gap: 8px; }
  .profile-nav a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 8px 12px; color: var(--text-secondary); border-radius: 10px; font-size: 14px; transition: color 160ms ease, background 160ms ease, transform 160ms ease; }
  .profile-nav a:hover { color: var(--text-primary); background: var(--surface-subtle); }
  .profile-nav .profile-nav-active { color: #fff; background: linear-gradient(100deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #f7a374)); }
  .home-intro { margin-bottom: 40px; padding: 32px 36px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
  .home-intro h2 { margin: 0; font-size: 32px; line-height: 1.3; }
  .home-intro > p:not(.home-eyebrow) { max-width: 720px; margin: 16px 0 0; color: var(--text-secondary); font-size: 16px; line-height: 1.8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero-action { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 20px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; font-weight: 650; transition: transform 160ms cubic-bezier(.23,1,.32,1), color 160ms ease, border-color 160ms ease, background 160ms ease; }
  .hero-action.primary { color: var(--button-on-accent); background: var(--accent); border-color: var(--accent); }
  .hero-action.secondary { color: var(--text-primary); background: color-mix(in srgb, var(--surface) 55%, transparent); }
  .hero-action:active { transform: scale(.97); }
  .hero-action:focus-visible, .section-link:focus-visible, .home-post-link:focus-visible, .info-fold > summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  .recent-section { padding: 0 0 64px; border-bottom: 1px solid var(--border); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  .section-heading h2, .info-strip-heading h2 { margin: 0; color: var(--text-primary); font-size: 28px; line-height: 1.25; }
  .section-link { color: var(--accent); font-size: 14px; font-weight: 650; }
  .recent-list { display: grid; gap: 24px; }
  .home-post-card { overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; }
  .home-post-link { display: grid; grid-template-columns: minmax(260px, .78fr) minmax(0, 1.22fr); min-height: 228px; color: inherit; }
  .home-post-media { position: relative; min-height: 228px; overflow: hidden; background: linear-gradient(145deg, hsl(var(--cover-hue) 78% 68%), color-mix(in srgb, var(--accent) 78%, var(--surface))); }
  .home-post-media :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 0; transition: transform 220ms cubic-bezier(.23,1,.32,1); }
  .cover-grid { position: absolute; inset: 0; opacity: .32; background-image: linear-gradient(rgba(255,255,255,.28) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.28) 1px, transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(to bottom right, black, transparent 82%); }
  .cover-letter { position: absolute; left: 32px; bottom: 32px; color: rgba(255,255,255,.94); font-size: 72px; font-weight: 800; line-height: 1; text-shadow: 0 8px 28px rgba(0,0,0,.18); }
  .cover-caption { position: absolute; right: 20px; top: 20px; padding: 4px 10px; color: rgba(255,255,255,.92); border: 1px solid rgba(255,255,255,.4); border-radius: 999px; font-size: 12px; }
  .home-post-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 32px 40px; }
  .post-meta-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; color: var(--text-secondary); font-size: 12px; }
  .post-meta-line > span { color: var(--accent); font-weight: 650; }
  .home-post-copy h3 { margin: 12px 0 0; color: var(--text-primary); font-size: 20px; line-height: 1.4; }
  .home-post-copy > p { display: -webkit-box; overflow: hidden; margin: 12px 0 0; color: var(--text-secondary); font-size: 16px; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .post-tags span { padding: 3px 9px; color: var(--text-secondary); background: var(--surface-subtle); border-radius: 999px; font-size: 12px; }
  .post-more { margin-top: 20px; color: var(--accent); font-size: 14px; font-weight: 650; }
  .home-empty { padding: 32px; color: var(--text-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .home-empty strong { color: var(--text-primary); font-size: 20px; }
  .home-empty p { margin: 8px 0 16px; font-size: 16px; }

  .home-info-strip { padding: 64px 0 0; }
  .info-strip-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
  .info-strip-heading > p { max-width: 520px; margin: 0; color: var(--text-secondary); font-size: 14px; text-align: right; }
  .info-strip-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-bottom: 1px solid var(--border); }
  .info-block { min-width: 0; padding: 32px 0; }
  .info-block + .info-block { padding-left: 40px; margin-left: 40px; border-left: 1px solid var(--border); }
  .info-block-heading { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 24px; }
  .info-block-heading > span, .info-fold > summary > span { color: var(--accent); font-size: 12px; font-weight: 700; }
  .info-block-heading h3 { margin: 0; color: var(--text-primary); font-size: 20px; }
  .info-block-heading p { margin: 4px 0 0; color: var(--text-secondary); font-size: 14px; }
  .language-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .language-grid > :global(*) { min-width: 0; }
  .language-block :global(.lang-card) { width: 100%; max-width: none; padding: 0; margin: 0; background: transparent; border: 0; box-shadow: none; }
  .language-block :global(.lang-title) { margin-bottom: 12px; color: var(--text-secondary); font-size: 14px; text-align: left; }
  .language-block :global(.lang-chart-row) { gap: 12px; }
  .language-block :global(.lang-pie) { width: 112px; height: 112px; }
  .language-block :global(.lang-legend) { gap: 3px; font-size: 11px; }
  .language-block :global(.lang-total) { margin-top: 8px; font-size: 12px; }
  .status-block :global(.system-status-heading) { display: none; }
  .status-block :global(.system-status-grid) { gap: 8px; }
  .status-block :global(.system-card) { min-height: 0; padding: 12px; background: color-mix(in srgb, var(--state-bg) 54%, transparent); border-radius: 8px; }
  .status-block :global(.system-card p) { margin-top: 6px; font-size: 12px; }
  .status-block :global(.system-card small), .status-block :global(.system-card a) { font-size: 11px; }

  .info-folds { display: grid; }
  .info-fold { border-bottom: 1px solid var(--border); }
  .info-fold > summary { display: grid; grid-template-columns: 32px minmax(180px, auto) minmax(0, 1fr); align-items: center; gap: 16px; padding: 20px 0; cursor: pointer; list-style: none; }
  .info-fold > summary::-webkit-details-marker, .maintenance-entry > summary::-webkit-details-marker { display: none; }
  .info-fold > summary::after { content: '+'; justify-self: end; color: var(--accent); font-size: 20px; transition: transform 180ms cubic-bezier(.23,1,.32,1); }
  .info-fold[open] > summary::after { transform: rotate(45deg); }
  .info-fold > summary strong { color: var(--text-primary); font-size: 16px; }
  .info-fold > summary small { color: var(--text-secondary); font-size: 14px; }
  .maintenance-list { max-height: 360px; overflow-y: auto; padding: 0 0 24px 48px; }
  .maintenance-entry { border-top: 1px solid color-mix(in srgb, var(--border) 72%, transparent); }
  .maintenance-entry > summary { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 16px; padding: 14px 0; cursor: pointer; list-style: none; }
  .maintenance-entry time { color: var(--accent); font-size: 12px; }
  .maintenance-entry > summary span { color: var(--text-primary); font-size: 14px; font-weight: 650; }
  .maintenance-body { padding: 0 0 16px 106px; color: var(--text-secondary); font-size: 14px; line-height: 1.65; }
  .maintenance-body :global(p), .maintenance-body :global(ul) { margin: 8px 0 0; }
  .contribution-content { padding: 0 0 32px 48px; }
  .contribution-content :global(.gh-contributions) { width: 100%; max-width: none; margin: 0; padding: 0; background: transparent; border: 0; border-radius: 0; }
  .contribution-content :global(.gh-contributions > .stat-label) { display: none; }
  .contribution-content :global(.gh-grid-wrapper) { padding: 16px 0; background: transparent; border: 0; }

  @media (hover: hover) and (pointer: fine) {
    .hero-action:hover { transform: translateY(-1px); }
    .home-post-card { transition: transform 180ms cubic-bezier(.23,1,.32,1), border-color 180ms ease, box-shadow 180ms ease; }
    .home-post-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: 0 12px 32px color-mix(in srgb, var(--text-primary) 9%, transparent); }
    .home-post-card:hover .home-post-media :global(img) { transform: scale(1.025); }
  }

  @media (max-width: 900px) {
    .home-content-layout { grid-template-columns: 1fr; width: min(100% - 32px, 760px); margin-top: -28px; gap: 32px; }
    .home-profile-card { position: relative; top: auto; }
