---
import { getCollection } from 'astro:content';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, fmtNum } from '../consts';
import { computeSiteStats } from '../lib/blogStats';
import { getRepoLanguages } from '../lib/repoStats';
import { parseMaintenance } from '../lib/maintenance';
import Layout from '../layouts/BlogPost.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import BlogList from '../components/blog/BlogList.astro';
import GitHubContributions from '../components/github/GitHubContributions.astro';
import GitHubRepoStats from '../components/github/GitHubRepoStats.astro';
import GitHubLanguages from '../components/github/GitHubLanguages.astro';
import PublicStatus from '../components/home/PublicStatus.astro';
import { withBase } from '../lib/urls';
import maintenanceSource from '../content/maintenance.md?raw';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: new URL(withBase('/'), Astro.site).href,
};

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stats = computeSiteStats(allPosts);
const { repoLanguages, totalRepoLines } = getRepoLanguages();
const maintenanceEntries = await parseMaintenance(maintenanceSource);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} pubDate={new Date()} sidebarsExpanded hidePageHeader>
  <JsonLd slot="head" data={websiteLd} />

  <div class="home-width-container">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="home-eyebrow">离子怪 · 个人记录</p>
        <h1 id="home-title">你好，我是 <span>{SITE_AUTHOR}</span></h1>
        <p class="hero-description">{SITE_DESCRIPTION} 在这里整理学习路径、技术实践，以及那些值得慢慢想清楚的问题。</p>
        <div class="hero-actions">
          <a class="hero-action primary" href={withBase('/blog/')}>浏览文章</a>
          <a class="hero-action" href={withBase('/about/')}>了解我</a>
        </div>
      </div>
      <section class="site-stats" aria-label="博客统计">
        <div class="stat-item"><strong>{stats.totalArticles}</strong><span>文章</span></div>
        <div class="stat-item"><strong>{stats.totalCategories}</strong><span>分类</span></div>
        <div class="stat-item"><strong>{stats.totalTags}</strong><span>标签</span></div>
        <div class="stat-item"><strong>{stats.daysSinceLaunch}</strong><span>建站天数</span></div>
        <div class="stat-item"><strong>{fmtNum(stats.totalWords)}</strong><span>累计字数</span></div>
        <div class="stat-item"><strong>{fmtNum(totalRepoLines)}</strong><span>代码行数</span></div>
      </section>
    </section>

    <section class="recent-posts home-section" aria-labelledby="recent-title">
      <div class="section-heading">
        <div><p class="home-eyebrow">LATEST NOTES</p><h2 id="recent-title">近期文章</h2></div>
        <a class="section-link" href={withBase('/blog/')}>查看全部 →</a>
      </div>
      <BlogList sort="time" posts={recentPosts} />
    </section>

    <section class="language-overview-panel home-section" aria-labelledby="language-title">
      <div class="language-overview-heading">
        <p class="home-eyebrow">CODE MIX</p>
        <h2 id="language-title">代码语言构成</h2>
        <span>把本站仓库与 GitHub 账户放在同一处查看</span>
      </div>
      <div class="language-overview-grid">
        <div class="language-overview-item"><GitHubRepoStats languages={repoLanguages} totalLines={totalRepoLines} /></div>
        <div class="language-overview-item"><GitHubLanguages /></div>
      </div>
    </section>

    <section class="home-operations home-section" aria-label="站点运行信息">
      <div class="home-status-panel"><PublicStatus /></div>
      <section class="maintenance-panel" aria-labelledby="maintenance-title">
      <div class="maintenance-heading">
        <p class="home-eyebrow">MAINTENANCE LOG</p>
        <h2 id="maintenance-title">近期博客维护公告</h2>
        <span>记录近期功能调整、问题修复与部署状态</span>
      </div>
      <div class="maintenance-scroll">
        {maintenanceEntries.map((entry, index) => (
          <details class="maintenance-entry" open={index === 0}>
            <summary><time datetime={entry.date}>{entry.date}</time><span>{entry.title}</span></summary>
            <div class="maintenance-body" set:html={entry.html}></div>
          </details>
        ))}
      </div>
      </section>
    </section>

    <section class="contribution-panel home-section" aria-label="GitHub 贡献"><GitHubContributions /></section>
  </div>
  </div>
</Layout>

<style>
  .home-width-container { width: 100%; min-width: 0; container-type: inline-size; }
  .home-page { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "hero" "recent" "languages" "operations" "contribution"; align-items: start; gap: 2rem; width: min(1180px, 100%); margin: 0 auto; padding: 2rem 1.5rem 3rem; text-align: left; }
  .home-page > * { min-width: 0; }
  .home-hero { grid-area: hero; display: grid; gap: 2rem; padding: 1rem 0 1.5rem; border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent); }
  .hero-copy { max-width: 44rem; }
  .home-eyebrow { margin: 0 0 .65rem; color: var(--accent); font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .hero-copy h1 { margin: 0; color: var(--foreground-light); font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -.02em; }
  .hero-copy h1 span { color: var(--accent-light); }
  .hero-description { max-width: 38rem; margin: 1rem 0 0; color: var(--foreground-dark); font-size: 1rem; line-height: 1.8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .hero-action { display: inline-flex; align-items: center; min-height: 2.5rem; padding: .55rem 1rem; color: var(--foreground); border: 1px solid var(--border); border-radius: var(--radius-lg); font-size: .875rem; transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast); }
  .hero-action:hover { color: var(--accent-light); border-color: var(--accent); background: rgba(var(--accent-rgb), .08); }
  .hero-action:active { transform: scale(.98); }
  .hero-action.primary { color: var(--background); background: var(--accent); border-color: var(--accent); font-weight: 700; }
  .hero-action.primary:hover { color: var(--background); background: var(--accent-light); }
  .hero-action:focus-visible, .section-link:focus-visible, .maintenance-entry summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .site-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; max-width: 34rem; border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .stat-item { display: grid; min-width: 0; min-height: 4.5rem; place-items: center; align-content: center; gap: .25rem; padding: .75rem .5rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .stat-item strong { color: var(--accent-light); font-size: 1.4rem; line-height: 1.2; }
  .stat-item span { color: var(--foreground-dark); font-size: .75rem; }
  .home-section { min-width: 0; overflow: hidden; background: color-mix(in srgb, var(--muted) 14%, transparent); border: 1px solid color-mix(in srgb, var(--border) 85%, transparent); border-radius: var(--radius-xl); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.25rem .25rem; }
  .section-heading h2 { margin: 0; color: var(--foreground-light); font-size: 1.25rem; }
  .section-link { flex: 0 0 auto; color: var(--accent); font-size: .8rem; }
  .section-link:hover { color: var(--accent-light); }
  .recent-posts { grid-area: recent; }
  .recent-posts :global(main) { width: 100%; max-width: 100%; margin: 0; padding: .75rem 1.25rem 1.25rem; }
  .recent-posts :global(.card-grid) { grid-template-columns: 1fr; gap: 0; margin: 0; }
  .recent-posts :global(.blog-card) { border-radius: 0; border-top: 1px solid color-mix(in srgb, var(--border) 68%, transparent); background: transparent; transition: background var(--transition-fast); }
  .recent-posts :global(.blog-card:first-child) { border-top: 0; }
  .recent-posts :global(.blog-card:hover) { transform: none; background: rgba(var(--accent-rgb), .05); }
  .recent-posts :global(.card-image) { display: none; }
  .recent-posts :global(.card-content) { gap: .35rem; padding: .9rem .25rem; }
  .recent-posts :global(.card-title) { font-size: 1rem; line-height: 1.4; }
  .recent-posts :global(.card-description) { max-width: 42rem; font-size: .875rem; line-height: 1.55; }
  .recent-posts :global(.card-date) { font-size: .75rem; }
  .recent-posts :global(.card-tag) { font-size: .7rem; }
  .language-overview-panel { grid-area: languages; padding: 1.25rem; }
  .language-overview-heading { margin-bottom: .75rem; }
  .language-overview-heading h2 { margin: .1rem 0 .25rem; color: var(--foreground-light); font-size: 1.25rem; }
  .language-overview-heading span { color: var(--foreground-dark); font-size: .875rem; }
  .language-overview-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; min-width: 0; }
  .language-overview-item { min-width: 0; }
  .language-overview-item > :global(*) { height: 100%; }
  .language-overview-item :global(.lang-card) { padding: .8rem .65rem; }
  .language-overview-item :global(.lang-title) { margin-bottom: .65rem; color: var(--foreground); font-size: .82rem; font-weight: 650; }
  .language-overview-item + .language-overview-item { border-left: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border)); }
  .language-overview-item :global(.lang-chart-row) { gap: .65rem; }
  .language-overview-item :global(.lang-pie) { width: 126px; height: 126px; }
  .language-overview-item :global(.lang-legend) { gap: .16rem; font-size: .68rem; }
  .language-overview-item :global(.lang-total) { margin-top: .45rem; font-size: .68rem; }
  .home-page :global(.lang-card), .home-page :global(.gh-contributions) { width: 100%; max-width: none; margin: 0; background: transparent; border: 0; border-radius: 0; }
  .home-page :global(.lang-card), .home-page :global(.gh-contributions) { display: flex; flex-direction: column; justify-content: center; }
  .home-page :global(.lang-card) { padding: .75rem .5rem .25rem; }
  .home-page :global(.lang-title), .home-page :global(.gh-contributions > .stat-label) { color: var(--foreground); font-size: .875rem; font-weight: 650; line-height: 1.4; }
  .home-page :global(.lang-chart-row) { gap: .75rem; }
  .home-page :global(.lang-pie) { width: 118px; height: 118px; }
  .home-page :global(.lang-legend) { gap: .2rem; font-size: .7rem; line-height: 1.35; }
  .home-page :global(.lang-total) { margin-top: .65rem; font-size: .72rem; }
  .home-page :global(.gh-grid-wrapper) { padding: .75rem; background: transparent; border: 0; border-radius: 0; }
  .home-operations { grid-area: operations; display: grid; gap: 1.25rem; padding: 1.25rem; }
  .home-status-panel { min-width: 0; }
  .home-status-panel :global(.system-status-heading) { margin-bottom: .75rem; }
  .home-status-panel :global(.system-status-heading h2) { font-size: 1.25rem; }
  .home-status-panel :global(.status-eyebrow) { font-size: .75rem; }
  .home-status-panel :global(.status-refresh) { min-height: 2.25rem; border-color: color-mix(in srgb, var(--border) 75%, transparent); font-size: .75rem; }
  .home-status-panel :global(.system-status-grid) { gap: .5rem; }
  .home-status-panel :global(.system-card) { min-height: 7.5rem; padding: .7rem; background: color-mix(in srgb, var(--state-bg) 68%, transparent); }
  .maintenance-panel { display: flex; flex-direction: column; min-height: 0; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .maintenance-heading { margin-bottom: .7rem; }
  .maintenance-heading h2 { margin: .15rem 0 0; font-size: 1.18rem; }
  .maintenance-heading span { color: var(--foreground-dark); font-size: .7rem; }
  .maintenance-scroll { display: grid; grid-auto-rows: max-content; align-content: start; flex: 1 1 auto; gap: .6rem; min-height: 0; max-height: 24rem; padding-right: .2rem; overflow-y: auto; scrollbar-gutter: stable; scrollbar-width: thin; }
  .maintenance-entry { overflow: hidden; padding: 0; margin: 0; background: color-mix(in srgb, var(--background) 42%, transparent); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .maintenance-entry[open] { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); }
  .maintenance-entry summary { position: relative; display: grid; gap: .22rem; padding: .72rem .8rem .72rem 1.1rem; margin: 0; color: var(--foreground); cursor: pointer; list-style: none; }
  .maintenance-entry[open] > summary { margin-bottom: 0; }
  .maintenance-entry summary::-webkit-details-marker { display: none; }
  .maintenance-entry summary::before { content: '›'; position: absolute; left: .45rem; top: .72rem; color: var(--accent); transform: rotate(0deg); transition: transform var(--transition-base); }
  .maintenance-entry[open] summary::before { transform: rotate(90deg); }
  .maintenance-entry summary time { color: var(--accent); font-size: .7rem; font-weight: 650; }
  .maintenance-entry summary span { padding-left: .35rem; font-size: .84rem; font-weight: 650; line-height: 1.45; }
  .maintenance-body { padding: 0 .9rem .85rem; color: var(--foreground-dark); font-size: .76rem; line-height: 1.65; }
  .maintenance-body :global(p), .maintenance-body :global(ul) { margin: .45rem 0 0; }
  .maintenance-body :global(ul) { padding-left: 1.2rem; }
  .contribution-panel { grid-area: contribution; min-height: 280px; padding: 1.25rem; }
  .contribution-panel :global(.gh-contributions) { width: 100%; max-width: none; margin: 0; }
  .contribution-panel :global(.gh-contributions > .stat-label) { margin-bottom: .8rem !important; color: var(--foreground); font-size: 1.08rem; font-weight: 650; line-height: 1.4; }
  .contribution-panel :global(.gh-grid-wrapper) { width: 100%; max-width: none; box-sizing: border-box; padding: 1rem 1.1rem .85rem; }
  .contribution-panel :global(.gh-grid-outer) { justify-content: center; }
  .contribution-panel :global(.gh-scroll-area) { justify-content: center; }

  @container (min-width: 680px) {
    .home-hero { grid-template-columns: minmax(0, 1fr); }
    .home-hero .site-stats { width: 100%; max-width: none; }
    .home-page { grid-template-columns: minmax(0, 1.15fr) minmax(340px, .85fr); grid-template-areas: "hero recent" "languages operations" "contribution contribution"; }
    .maintenance-scroll { max-height: 20rem; }
  }

  @container (min-width: 1040px) {
    .home-page { gap: 2.5rem; padding-inline: 2rem; }
    .home-operations { gap: 1.5rem; }
  }

  @media (max-width: 760px) {
    .home-page { gap: 1.5rem; padding: 1.25rem .75rem 2.5rem; }
    .hero-copy h1 { font-size: 2rem; }
    .hero-description { font-size: .875rem; }
    .home-hero { gap: 1.5rem; }
    .language-overview-panel { padding: .95rem .8rem 1rem; }
    .language-overview-grid { gap: .5rem; }
    .language-overview-item :global(.lang-pie) { width: 112px; height: 112px; }
    .home-operations { padding: 1rem; }
    .site-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .language-overview-panel { padding: 1rem .85rem; }
  }
  @media (max-width: 420px) {
    .stat-item { min-height: 4.2rem; padding-inline: .35rem; }
    .stat-item strong { font-size: 1.25rem; }
    .language-overview-grid { grid-template-columns: 1fr; }
    .language-overview-item + .language-overview-item { padding-top: .7rem; border-top: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border)); border-left: 0; }
    .contribution-panel :global(.gh-grid-outer) { justify-content: flex-start; }
    .contribution-panel :global(.gh-scroll-area) { justify-content: flex-start; }
    .contribution-panel { min-height: 250px; padding-inline: .8rem; }
  }
</style>
