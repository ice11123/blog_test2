---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE, fmtNum } from '../consts';
import { computeSiteStats } from '../lib/blogStats';
import { getRepoLanguages } from '../lib/repoStats';
import { parseMaintenance } from '../lib/maintenance';
import PublicLayout from '../layouts/PublicLayout.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import GitHubContributions from '../components/github/GitHubContributions.astro';
import GitHubRepoStats from '../components/github/GitHubRepoStats.astro';
import GitHubLanguages from '../components/github/GitHubLanguages.astro';
import PublicStatus from '../components/home/PublicStatus.astro';
import RecentPosts from '../components/home/RecentPosts.astro';
import TopicAtlas from '../components/home/TopicAtlas.astro';
import { withBase } from '../lib/urls';
import maintenanceSource from '../content/maintenance.md?raw';
import homeHeroImage from '../assets/home-hero.jpg';
import homeHeroDarkImage from '../assets/home-hero-dark.png';

const homeHeroWidths = [640, 960, 1440];
const homeHeroFullWidths = [1440, 1920, 2560, 3840];
const [
  homeHeroLqip,
  homeHeroWebpSources,
  homeHeroFullSources,
  homeHeroDarkLqip,
  homeHeroDarkAvifSources,
  homeHeroDarkWebpSources,
  homeHeroDarkFullSources,
] = await Promise.all([
  getImage({ src: homeHeroImage, width: 64, format: 'webp', quality: 28 }),
  Promise.all(homeHeroWidths.map((width) => getImage({ src: homeHeroImage, width, format: 'webp', quality: 80 }))),
  Promise.all(homeHeroFullWidths.map((width) => getImage({ src: homeHeroImage, width, format: 'webp', quality: 90 }))),
  getImage({ src: homeHeroDarkImage, width: 64, format: 'webp', quality: 28 }),
  Promise.all(homeHeroWidths.map((width) => getImage({ src: homeHeroDarkImage, width, format: 'avif', quality: 58 }))),
  Promise.all(homeHeroWidths.map((width) => getImage({ src: homeHeroDarkImage, width, format: 'webp', quality: 80 }))),
  Promise.all(homeHeroFullWidths.map((width) => getImage({ src: homeHeroDarkImage, width, format: 'webp', quality: 90 }))),
]);
const toSrcset = (sources: typeof homeHeroWebpSources, widths: number[]) => sources
  .map((source, index) => `${source.src} ${widths[index]}w`)
  .join(', ');
const homeHeroWebpSrcset = toSrcset(homeHeroWebpSources, homeHeroWidths);
const homeHeroFullSrcset = homeHeroFullSources
  .map((source, index) => `${source.src} ${homeHeroFullWidths[index]}w`)
  .join(', ');
const homeHeroFallback = homeHeroWebpSources.at(-1)?.src ?? homeHeroLqip.src;
const homeHeroFullFallback = homeHeroFullSources.at(-1)?.src ?? homeHeroLqip.src;
const homeHeroDarkAvifSrcset = toSrcset(homeHeroDarkAvifSources, homeHeroWidths);
const homeHeroDarkWebpSrcset = toSrcset(homeHeroDarkWebpSources, homeHeroWidths);
const homeHeroDarkFullSrcset = homeHeroDarkFullSources
  .map((source, index) => `${source.src} ${homeHeroFullWidths[index]}w`)
  .join(', ');
const homeHeroDarkFallback = homeHeroDarkWebpSources.at(-1)?.src ?? homeHeroDarkLqip.src;
const homeHeroDarkFullFallback = homeHeroDarkFullSources.at(-1)?.src ?? homeHeroDarkLqip.src;
const homeGentleWavePath = 'M-192 36C-176 22-160 22-144 36S-112 50-96 36S-64 22-48 36S-16 50 0 36S32 22 48 36S80 50 96 36S128 22 144 36S176 50 192 36S224 22 240 36S272 50 288 36S320 22 336 36S368 50 384 36V64H-192Z';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: new URL(withBase('/'), Astro.site).href,
};

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const stats = computeSiteStats(allPosts);
const { repoLanguages, totalRepoLines } = getRepoLanguages();
const maintenanceEntries = await parseMaintenance(maintenanceSource);
const recentMaintenanceEntries = maintenanceEntries.slice(0, 3);
---

<PublicLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <JsonLd slot="head" data={websiteLd} />

  <div class="home-page">
    <div
      class="home-cover-shell"
      id="home-cover"
      data-home-cover
      data-expanded="false"
      style={`--home-cover-light-lqip: url("${homeHeroLqip.src}"); --home-cover-dark-lqip: url("${homeHeroDarkLqip.src}")`}
    >
      <section class="home-cover" aria-labelledby="home-title" aria-describedby="home-cover-description">
      <div class="cover-photo-frame" aria-hidden="true">
        <picture>
          <source
            data-home-hero-source
            type="image/webp"
            data-light-type="image/webp"
            data-light-srcset={homeHeroWebpSrcset}
            data-dark-type="image/avif"
            data-dark-srcset={homeHeroDarkAvifSrcset}
            sizes="(min-width: 1688px) 1440px, (min-width: 1200px) calc(100vw - 248px), (min-width: 1000px) calc(100vw - 220px), 100vw"
          />
          <img
            class="cover-photo"
            data-home-hero-photo
            src={homeHeroLqip.src}
            data-light-src={homeHeroFallback}
            data-light-srcset={homeHeroWebpSrcset}
            data-dark-src={homeHeroDarkFallback}
            data-dark-srcset={homeHeroDarkWebpSrcset}
            sizes="(min-width: 1688px) 1440px, (min-width: 1200px) calc(100vw - 248px), (min-width: 1000px) calc(100vw - 220px), 100vw"
            alt=""
            width={homeHeroImage.width}
            height={homeHeroImage.height}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <script is:inline>
          (() => {
            const frame = document.currentScript?.parentElement;
            const source = frame?.querySelector('[data-home-hero-source]');
            const photo = frame?.querySelector('[data-home-hero-photo]');
            if (!(source instanceof HTMLSourceElement) || !(photo instanceof HTMLImageElement)) return;
            const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
            const sourceType = source.getAttribute(`data-${theme}-type`);
            const sourceSrcset = source.getAttribute(`data-${theme}-srcset`);
            const photoSrcset = photo.getAttribute(`data-${theme}-srcset`);
            const photoSrc = photo.getAttribute(`data-${theme}-src`);
            if (!sourceType || !sourceSrcset || !photoSrcset || !photoSrc) return;
            source.type = sourceType;
            source.srcset = sourceSrcset;
            photo.srcset = photoSrcset;
            photo.src = photoSrc;
          })();
        </script>
      </div>
      <div class="cover-photo-overlay" aria-hidden="true"></div>
      <div class="cover-copy">
        <p class="home-eyebrow">ION MONSTER · PERSONAL NOTES</p>
        <h1 id="home-title">离子怪的博客</h1>
        <p>记录学习、技术与思考的个人博客</p>
      </div>
      <span class="sr-only" id="home-cover-description">展开后完整展示主页壁纸，可点击箭头、使用桌面滚轮、按 Escape 或向下滑动收回。</span>
      <div class="cover-gesture-zone" data-home-cover-gesture aria-hidden="true"></div>
      </section>
      <div class="cover-full-stage" data-home-cover-stage aria-hidden="true">
        <div class="cover-full-viewport" data-home-cover-viewport>
          <img
            class="cover-full-photo"
            data-home-hero-full
            src={homeHeroLqip.src}
            data-light-lqip={homeHeroLqip.src}
            data-dark-lqip={homeHeroDarkLqip.src}
            data-full-src={homeHeroFullFallback}
            data-full-srcset={homeHeroFullSrcset}
            data-light-full-src={homeHeroFullFallback}
            data-light-full-srcset={homeHeroFullSrcset}
            data-dark-full-src={homeHeroDarkFullFallback}
            data-dark-full-srcset={homeHeroDarkFullSrcset}
            data-full-sizes="(min-width: 1200px) calc(100vw - 248px), (min-width: 1000px) calc(100vw - 220px), 100vw"
            alt=""
            width={homeHeroImage.width}
            height={homeHeroImage.height}
            decoding="async"
          />
        </div>
      </div>
      <button
        type="button"
        class="cover-expand-toggle"
        data-home-cover-toggle
        aria-controls="home-cover"
        aria-expanded="false"
        aria-label="展开全图壁纸"
        title="展开全图壁纸"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="m6 15 6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="sr-only" data-home-cover-toggle-label>展开全图壁纸</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite" data-home-cover-status></span>
    </div>

    <div class="home-drawer" data-home-lower-motion>
      <div class="cover-waves" aria-hidden="true">
        <div class="cover-wave-layer cover-wave-layer-back">
          <svg class="cover-wave-shape" viewBox="0 0 192 64" preserveAspectRatio="none">
            <path d={homeGentleWavePath} transform="translate(0 0)" />
          </svg>
        </div>
        <div class="cover-wave-layer cover-wave-layer-middle">
          <svg class="cover-wave-shape" viewBox="0 0 192 64" preserveAspectRatio="none">
            <path d={homeGentleWavePath} transform="translate(0 6)" />
          </svg>
        </div>
        <div class="cover-wave-layer cover-wave-layer-front">
          <svg class="cover-wave-shape" viewBox="0 0 192 64" preserveAspectRatio="none">
            <path d={homeGentleWavePath} transform="translate(0 12)" />
          </svg>
        </div>
      </div>
      <div class="home-content-layout">
        <div class="home-main-column">
    <TopicAtlas posts={allPosts} />
    <RecentPosts posts={recentPosts} />

    <section class="home-info-strip" aria-labelledby="site-info-title" data-home-motion-cull>
      <header class="info-strip-heading">
        <div>
          <p class="section-kicker">SITE NOTES</p>
          <h2 id="site-info-title">站点信息</h2>
        </div>
        <p>
          已运行 {stats.daysSinceLaunch} 天 · 累计 {fmtNum(stats.totalWords)} 字 · 仓库 {fmtNum(totalRepoLines)} 行代码
        </p>
      </header>

      <div class="info-strip-grid">
        <section class="info-block language-block" aria-labelledby="language-title">
          <div class="info-block-heading">
            <span>01</span>
            <div><h3 id="language-title">代码语言构成</h3><p>本站仓库与 GitHub 账户</p></div>
          </div>
          <div class="language-grid">
            <GitHubRepoStats languages={repoLanguages} totalLines={totalRepoLines} />
            <GitHubLanguages />
          </div>
        </section>

        <section class="info-block status-block" aria-label="系统状态">
          <div class="info-block-heading">
            <span>02</span>
            <div><h3>运行状态</h3><p>按需检测，不持续轮询</p></div>
            <button type="button" class="status-refresh" data-public-status-refresh aria-controls="public-status-grid" aria-label="重新检测系统状态">
              <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span data-public-status-refresh-label>刷新</span>
            </button>
          </div>
          <PublicStatus />
        </section>
      </div>

        <section class="maintenance-section" aria-labelledby="maintenance-title">
          <header class="maintenance-heading">
            <div class="info-block-heading">
              <span>03</span>
              <div><h3 id="maintenance-title">近期维护公告</h3><p>记录每一次小小的进步</p></div>
            </div>
            <a class="maintenance-archive-link" href={withBase('/maintenance/')}>全部记录 <span aria-hidden="true">↗</span></a>
          </header>
          <div class="maintenance-list">
            {recentMaintenanceEntries.map((entry, index) => (
              <details class="maintenance-entry">
                <summary>
                  <time datetime={entry.date}>{entry.date}</time>
                  <span class="maintenance-entry-copy">
                    <span class="maintenance-entry-title">{entry.title}{index === 0 && <span class="maintenance-badge">最近更新</span>}</span>
                    <span class="maintenance-entry-hint" set:html={entry.html.match(/<li>([\s\S]*?)<\/li>/)?.[1] || '点击查看调整与修复详情'}></span>
                  </span>
                  <svg class="maintenance-chevron" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="maintenance-body" set:html={entry.html}></div>
              </details>
            ))}
          </div>
        </section>

      <div class="info-folds">
        <details class="info-fold contribution-fold">
          <summary><span>04</span><strong>GitHub 贡献记录</strong><small>过去一年的公开贡献活跃度</small></summary>
          <div class="contribution-content"><GitHubContributions /></div>
        </details>
      </div>
    </section>
      </div>
    </div>
    </div>
  </div>
  <script src="../scripts/home-hero-motion.ts"></script>
</PublicLayout>

<style>
  .home-page {
    width: 100%;
    margin: 0;
    padding: 0 0 64px;
    overflow: clip;
    color: var(--text-primary);
    text-align: left;
  }

  .home-cover {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(540px, 42vw, 660px);
    overflow: hidden;
    color: #fff;
    background: var(--cover-start);
  }

  .home-cover-shell {
    --home-cover-lqip: var(--home-cover-light-lqip);
    position: relative;
    min-height: clamp(540px, 42vw, 660px);
    background: var(--cover-start);
  }
  :global([data-theme='dark']) .home-cover-shell { --home-cover-lqip: var(--home-cover-dark-lqip); }
  .home-cover-shell .home-cover { min-height: inherit; }

  .cover-photo-frame { position: absolute; z-index: 0; inset: 0; overflow: hidden; background: #0a0d0d var(--home-cover-lqip) center / cover no-repeat; }
  .cover-photo-frame picture { display: block; width: 100%; height: 100%; }
  .cover-photo-frame :global(.cover-photo) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% 55%;
    border-radius: 0;
  }
  .cover-photo-overlay,
  .cover-full-viewport::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(25, 5, 15, .72) 0%, rgba(34, 8, 24, .42) 36%, rgba(20, 4, 18, .1) 68%),
      linear-gradient(180deg, rgba(14, 4, 18, .12) 35%, rgba(14, 4, 18, .48) 100%);
  }
  .cover-full-viewport::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }
  :global([data-theme='dark']) .cover-photo-overlay,
  :global([data-theme='dark']) .cover-full-viewport::after {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, .76) 0%, rgba(0, 0, 0, .42) 38%, rgba(0, 0, 0, .08) 70%),
      linear-gradient(180deg, rgba(0, 0, 0, .08) 30%, rgba(0, 0, 0, .4) 100%);
  }
  :global([data-theme='dark']) .cover-photo-frame :global(.cover-photo) { object-position: 62% 52%; }
  .cover-copy { position: relative; z-index: 901; width: min(780px, calc(100% - 64px)); box-sizing: border-box; margin-right: auto; padding: 32px 24px 108px max(48px, 8vw); text-align: left; text-shadow: 0 3px 24px rgba(12, 4, 18, .58); }
  .home-eyebrow, .section-kicker { margin: 0 0 12px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  .cover-copy .home-eyebrow { color: rgba(255,255,255,.78); }
  .cover-copy h1 { margin: 0; color: #fff; font-size: 48px; line-height: 1.2; letter-spacing: .08em; }
  .cover-copy > p:last-child { margin: 20px 0 0; color: rgba(255,255,255,.86); font-size: 16px; letter-spacing: .08em; }
  .cover-full-stage {
    position: fixed;
    z-index: 900;
    top: var(--site-header-height, 81px);
    right: auto;
    bottom: 0;
    left: 0;
    display: grid;
    width: 100vw;
    visibility: hidden;
    overflow: hidden;
    place-items: center;
    pointer-events: none;
    transform-origin: 0 0;
  }
  .cover-full-viewport {
    position: absolute;
    inset: 0;
    background: #0a0d0d var(--home-cover-lqip) center / cover no-repeat;
    transform-origin: 0 0;
  }
  .cover-full-viewport > :global(.cover-full-photo) {
    position: absolute;
    z-index: 0;
    display: block;
    top: 0;
    left: 0;
    width: auto;
    max-width: none;
    height: auto;
    border-radius: 0;
    transform-origin: 0 0;
  }
  .cover-expand-toggle {
    position: absolute;
    z-index: 922;
    top: 16px;
    left: 50%;
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    color: #fff;
    background: rgba(8, 12, 14, .3);
    border: 1px solid rgba(255, 255, 255, .7);
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .24);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    touch-action: pan-x pinch-zoom;
    transform: translateX(-50%);
    transition: transform 150ms var(--ease-out), background-color 150ms ease, border-color 150ms ease;
  }
  .cover-expand-toggle svg { transition: transform 140ms var(--ease-out); }
  .cover-expand-toggle:active { transform: translateX(-50%) scale(.96); }
  .cover-expand-toggle:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .cover-gesture-zone {
    position: absolute;
    z-index: 921;
    top: 0;
    left: 50%;
    width: 144px;
    height: 88px;
    touch-action: pan-x pinch-zoom;
    transform: translateX(-50%);
  }
  .cover-waves {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: calc(100% - 1px);
    left: 0;
    display: block;
    width: 100%;
    height: clamp(64px, 13dvh, 150px);
    overflow: hidden;
    pointer-events: none;
  }
  .cover-wave-layer {
    position: absolute;
    inset: 0;
    animation-name: cover-wave-drift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-play-state: paused;
  }
  .cover-wave-shape {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cover-wave-layer-back {
    fill: color-mix(in srgb, var(--canvas) 72%, var(--accent) 28%);
    opacity: .58;
    animation-duration: 12s;
    animation-delay: -2s;
  }
  .cover-wave-layer-middle {
    fill: color-mix(in srgb, var(--canvas) 84%, var(--accent) 16%);
    opacity: .76;
    animation-duration: 7s;
    animation-delay: -3s;
  }
  .cover-wave-layer-front {
    fill: var(--canvas);
    animation-duration: 4s;
    animation-delay: -4s;
  }
  .home-drawer[data-waves-visible='true'] .cover-wave-layer {
    animation-play-state: running;
    will-change: transform;
  }

  :global(html[data-home-cover-motion-active='true']),
  :global(html[data-home-cover-expanded='true']) {
    overflow: hidden;
    scrollbar-gutter: auto;
  }
  :global(html[data-home-cover-motion-active='true']) .home-page,
  :global(html[data-home-cover-expanded='true']) .home-page { overflow: visible; }
  :global(html[data-home-cover-motion-active='true']) .cover-full-stage,
  .home-cover-shell[data-state='expanded'] .cover-full-stage { visibility: visible; }
  :global(html[data-home-cover-motion-active='true']) .cover-expand-toggle {
    position: fixed;
    top: calc(var(--site-header-height, 81px) + 16px);
    left: var(--home-cover-stage-center, 50vw);
  }
  :global(html[data-home-cover-motion-active='true']) .cover-gesture-zone,
  .home-cover-shell[data-state='expanded'] .cover-gesture-zone {
    position: fixed;
    top: var(--site-header-height, 81px);
    left: var(--home-cover-stage-center, 50vw);
  }
  :global(html[data-home-cover-motion-active='true']) .home-drawer {
    position: relative;
    z-index: 910;
    pointer-events: none;
  }
  :global(html[data-home-cover-motion-active='true'] [data-persistent-sidebar]),
  :global(html[data-home-cover-expanded='true'] [data-persistent-sidebar]) {
    z-index: 910;
  }
  .home-cover-shell[data-state='expanded'] .home-cover { visibility: hidden; }
  .home-cover-shell[data-state='expanded'] .cover-expand-toggle {
    position: fixed;
    top: calc(var(--site-header-height, 81px) + 16px);
    left: var(--home-cover-stage-center, 50vw);
  }
  .home-cover-shell[data-state='expanded'] .cover-expand-toggle svg { transform: rotate(180deg); }

  .home-content-layout { position: relative; z-index: 4; width: min(1080px, calc(100% - 48px)); margin: 40px auto 0; }
  .home-main-column { min-width: 0; }
  .home-drawer { position: relative; z-index: 4; display: flow-root; min-width: 0; background: var(--canvas); }
  .home-drawer :global([data-home-motion-offscreen='true']) { visibility: hidden; }
  .info-fold > summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  .home-info-strip {
    padding: 16px 0 0;
    content-visibility: auto;
    contain-intrinsic-block-size: auto 960px;
  }
  .info-strip-heading h2 { margin: 0; color: var(--text-primary); font-size: 28px; line-height: 1.25; }
  .info-strip-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-bottom: 24px; }
  .info-strip-heading > p { max-width: 520px; margin: 0; color: var(--text-secondary); font-size: 14px; text-align: right; }
  .info-strip-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .info-block { min-width: 0; padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); }
  .info-block-heading { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 24px; }
  .info-block-heading > span, .info-fold > summary > span { display: grid; flex-shrink: 0; place-items: center; width: 28px; height: 28px; color: var(--accent); background: var(--surface-subtle); border-radius: 8px; font-size: 11px; font-weight: 700; font-variant-numeric: tabular-nums; }
