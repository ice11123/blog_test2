---
import PublicLayout from '../layouts/PublicLayout.astro';
import { SITE_TITLE } from '../consts';
import { parseMaintenance } from '../lib/maintenance';
import maintenanceSource from '../content/maintenance.md?raw';

const entries = await parseMaintenance(maintenanceSource);
---

<PublicLayout title={`维护记录 | ${SITE_TITLE}`} description="博客功能调整、可靠性修复和部署记录归档。">
  <section class="maintenance-page" aria-labelledby="maintenance-title">
    <header>
      <p class="eyebrow">MAINTENANCE ARCHIVE</p>
      <h1 id="maintenance-title">维护记录</h1>
      <p>共 {entries.length} 条，按时间倒序排列。</p>
    </header>

    <div class="maintenance-timeline">
      {entries.map((entry, index) => (
        <details class="maintenance-record" open={index === 0}>
          <summary>
            <time datetime={entry.date}>{entry.date}</time>
            <span>{entry.title}</span>
          </summary>
          <div class="maintenance-body" set:html={entry.html}></div>
        </details>
      ))}
    </div>
  </section>
</PublicLayout>

<style>
  .maintenance-page { width: min(920px, calc(100% - 32px)); margin: 0 auto; padding: 64px 0 96px; }
  header { margin-bottom: 40px; }
  .eyebrow { margin: 0 0 10px; color: var(--accent); font-size: 12px; font-weight: 750; letter-spacing: .16em; }
  h1 { margin: 0; color: var(--text-primary); font-size: clamp(2rem, 6vw, 3.5rem); }
  header > p:last-child { color: var(--text-secondary); }
  .maintenance-timeline { border-top: 1px solid var(--border); }
  .maintenance-record { border-bottom: 1px solid var(--border); content-visibility: auto; contain-intrinsic-size: auto 72px; }
  .maintenance-record > summary { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 18px; padding: 20px 4px; color: var(--text-primary); cursor: pointer; list-style: none; }
  .maintenance-record > summary::-webkit-details-marker { display: none; }
  time { color: var(--accent); font-size: 12px; }
  summary span { font-weight: 650; }
  .maintenance-body { padding: 0 4px 24px 114px; color: var(--text-secondary); line-height: 1.75; }
  .maintenance-body :global(p), .maintenance-body :global(ul) { margin: 8px 0 0; }
  @media (max-width: 640px) {
    .maintenance-page { padding-top: 40px; }
    .maintenance-record > summary { grid-template-columns: 76px minmax(0, 1fr); gap: 12px; }
    .maintenance-body { padding-left: 4px; }
  }
</style>
