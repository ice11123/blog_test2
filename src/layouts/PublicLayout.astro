---
import HtmlHead from '../components/layout/HtmlHead.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SearchModal from '../components/blog/SearchModal.astro';
import SidebarLeft from '../components/layout/SidebarLeft.astro';
import { getSidebarData } from '../lib/blogData';
import { stripBase } from '../lib/urls';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const sidebarData = await getSidebarData();
const routePath = stripBase(Astro.url.pathname);
const slugMatch = routePath.match(/^\/blog\/(.+)/);
const currentSlug = slugMatch ? decodeURIComponent(slugMatch[1].replace(/\/+$/, '')) : '';
---

<html lang="zh-cn">
  <head>
    <HtmlHead title={title} description={description} />
    <slot name="head" />
  </head>
  <body class="public-shell">
    <Header />
    <div class="public-layout-frame">
      <SidebarLeft posts={sidebarData} currentSlug={currentSlug} />
      <div class="sidebar-gutter" id="left-gutter">
        <button class="sidebar-toggle-btn" id="toggleLeftSidebarBtn" aria-label="打开文章目录" type="button">
          <svg class="gutter-arrow gutter-arrow-left" width="18" height="18" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2 5 L6 8 L10 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <main class="public-main">
        <slot />
      </main>
    </div>
    <Footer />
    <SearchModal />
    <script src="../scripts/sidebar-tree"></script>
  </body>
</html>

<style>
  .public-shell {
    min-height: 100vh;
    background: var(--canvas);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  .public-shell .public-main {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .public-layout-frame {
    display: flex;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .public-layout-frame {
      padding-left: 16px;
      box-sizing: border-box;
    }
  }
</style>
