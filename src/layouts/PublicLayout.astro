---
import type { ImageMetadata } from 'astro';
import HtmlHead from '../components/layout/HtmlHead.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import PersistentSidebar from '../components/layout/PersistentSidebar.astro';
import ArticleTocSidebar from '../components/layout/ArticleTocSidebar.astro';
import MobileSidebarControls from '../components/layout/MobileSidebarControls.astro';
import SearchModal from '../components/blog/SearchModal.astro';
import { getSidebarData } from '../lib/blogData';

interface Props {
  title: string;
  description: string;
  image?: string | ImageMetadata;
  sidebarMode?: 'overview' | 'article';
  currentSlug?: string;
  currentDir1?: string;
  currentDir2?: string;
}

const {
  title,
  description,
  image,
  sidebarMode = 'overview',
  currentSlug = '',
  currentDir1 = '',
  currentDir2 = '',
} = Astro.props;
const sidebarPosts = await getSidebarData();
---

<html lang="zh-cn">
  <head>
    <HtmlHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body class="public-shell">
    <Header />
    <div class:list={['public-layout-frame', { 'has-article-toc': sidebarMode === 'article' }]}>
      <PersistentSidebar
        posts={sidebarPosts}
        currentSlug={currentSlug}
        currentDir1={currentDir1}
        currentDir2={currentDir2}
      />
      <main class="public-main">
        <slot />
      </main>
      {sidebarMode === 'article' && <ArticleTocSidebar />}
    </div>
    <MobileSidebarControls hasArticleToc={sidebarMode === 'article'} />
    <Footer />
    <SearchModal />
  </body>
</html>

<style>
  .public-shell {
    min-height: 100vh;
    background:
      radial-gradient(circle at 56% 5%, color-mix(in srgb, var(--accent) 4%, transparent), transparent 34rem),
      var(--canvas);
    font-family: var(--font-sans-zh);
  }

  .public-shell .public-main {
    position: relative;
    z-index: 0;
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    min-height: calc(100dvh - 81px);
    max-width: none;
    margin: 0;
    padding: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-subtle) 20%, transparent), transparent 18rem);
    box-shadow:
      inset 1px 0 0 color-mix(in srgb, white 28%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--border) 48%, transparent);
  }

  .public-layout-frame {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    align-items: start;
    width: 100%;
    min-width: 0;
  }

  .public-layout-frame.has-article-toc {
    grid-template-columns: 248px minmax(0, 1fr) 236px;
  }

  @media (max-width: 1199px) and (min-width: 1100px) {
    .public-layout-frame { grid-template-columns: 220px minmax(0, 1fr); }
    .public-layout-frame.has-article-toc { grid-template-columns: 220px minmax(0, 1fr) 210px; }
  }

  @media (max-width: 1099.98px) {
    .public-layout-frame { display: block; }
    .public-shell .public-main {
      min-height: calc(100dvh - var(--public-header-height, 100px));
      box-shadow: none;
    }
  }
</style>
