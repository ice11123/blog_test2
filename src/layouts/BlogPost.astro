---
// 博客文章布局组件 - 统一常驻侧栏版本
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/blog/FormattedDate.astro';
import PublicLayout from './PublicLayout.astro';
import { stripBase, withBase } from '../lib/urls';
import blogPostCss from '../styles/blog-post.scss?url';
import katexCss from 'katex/dist/katex.min.css?url';
import { SITE_AUTHOR, TARGET_REPOSITORY } from '../consts';

type BlogData = CollectionEntry<'blog'>['data'];
type Props = Omit<BlogData, 'tags'> & { tags?: string[]; sidebarsExpanded?: boolean; hidePageHeader?: boolean };
const { title, description, pubDate, updatedDate, author = SITE_AUTHOR, sourceUrl = `https://github.com/${TARGET_REPOSITORY}`, heroImage, dir1, dir2, tags = [], hidePageHeader = false } = Astro.props;

const routePath = stripBase(Astro.url.pathname);
const slugMatch = routePath.match(/^\/blog\/(.+)/);
const currentSlug = slugMatch ? decodeURIComponent(slugMatch[1].replace(/\/+$/, '')) : '';
---

<PublicLayout
	title={title}
	description={description}
	image={heroImage}
	sidebarMode="article"
	currentSlug={currentSlug}
	currentDir1={dir1}
	currentDir2={dir2}
>
	<link slot="head" rel="stylesheet" href={blogPostCss} />
	<link slot="head" rel="stylesheet" href={katexCss} />
	<slot name="head" slot="head" />
	<article class="blog-post-page">
		{!hidePageHeader && heroImage && (
			<div class="hero-image"><Image width={960} height={420} src={heroImage} alt="" /></div>
		)}
		<div class="content-main">
			<div class="prose">
				{!hidePageHeader && <div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
					</div>
					<h1>{title}</h1>
						<div class="post-meta" aria-label="文章信息">
							<a class="post-source" href={sourceUrl} target="_blank" rel="noopener noreferrer" title={sourceUrl}>
								<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.5 6.1-6.8A5.3 5.3 0 0 0 18.7 4a5 5 0 0 0-.1-3s-1.2-.4-3.9 1.5a13.4 13.4 0 0 0-7 0C5 .6 3.8 1 3.8 1a5 5 0 0 0-.1 3A5.3 5.3 0 0 0 2.2 8c0 5.3 3.1 6.5 6.1 6.8a3.4 3.4 0 0 0-.9 2.7v3.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
								GitHub 源地址 <span aria-hidden="true">↗</span>
							</a>
							<span class="post-meta-item"><span class="post-meta-label">作者</span>{author}</span>
							<span class="post-meta-item"><span class="post-meta-label">最近编辑</span><FormattedDate date={updatedDate ?? pubDate} /></span>
							{dir1 && <span class="post-category">
								分类：<a href={withBase(`/blog/category/${encodeURIComponent(dir1)}/`)}>{dir1}</a>
								{dir2 && <span> / <a href={withBase(`/blog/category/${encodeURIComponent(dir1)}/${encodeURIComponent(dir2)}/`)}>{dir2}</a></span>}
							</span>}
							{tags.length > 0 && <span class="post-tags">{tags.map((tag) => <a href={withBase(`/blog/tag/${encodeURIComponent(tag)}/`)} class="tag-pill">{tag}</a>)}</span>}
						</div>
					<hr />
				</div>}
				<slot />
			</div>
		</div>
	</article>
	<script src="../scripts/toc"></script>
	<script src="../scripts/mermaid"></script>
</PublicLayout>
