---
import Icon from './Icon.astro';
---

<div class="header-tools" aria-label="站点工具">
  <button id="search-trigger-btn" class="header-tool-button header-search-button" aria-label="搜索文章 (Ctrl+K)" title="搜索 (Ctrl+K)" type="button">
    <Icon name="search" />
    <span>搜索</span>
    <span class="header-search-shortcut">Ctrl+K</span>
  </button>
  <button id="theme-switcher-btn" class="header-tool-button header-theme-button" aria-label="切换到深色主题" aria-pressed="false" title="切换到深色主题" type="button">
    <span class="theme-icon theme-icon-sun" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </span>
    <span class="theme-icon theme-icon-moon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
      </svg>
    </span>
    <span>主题</span>
  </button>
</div>

<style>
  .header-tools { display: grid; grid-template-columns: minmax(9.5rem, 1.65fr) minmax(5.8rem, 1fr); gap: .4rem; min-width: 0; }
  .header-tool-button { display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: 2rem; padding: .38rem .55rem; color: var(--foreground-dark); background: transparent; border: 1px solid var(--border); border-radius: var(--radius-lg); font: inherit; font-size: var(--font-size-sm); white-space: nowrap; cursor: pointer; transition: transform 140ms var(--ease-out), color var(--transition-base), border-color var(--transition-base), background-color var(--transition-base); }
  .header-tool-button:active { transform: scale(.97); }
  .header-search-shortcut { color: var(--foreground-dark); font-size: .62rem; opacity: .72; }
  .header-theme-button { width: 100%; }
  .theme-icon { display: inline-flex; align-items: center; justify-content: center; }
  .theme-icon-moon { display: none; }
  :global([data-theme='dark']) .theme-icon-sun { display: none; }
  :global([data-theme='dark']) .theme-icon-moon { display: inline-flex; }
  @media (hover: hover) and (pointer: fine) {
    .header-tool-button:hover { color: var(--foreground); border-color: var(--accent); background: rgba(var(--accent-rgb), var(--alpha-hover)); }
  }
  @media (max-width: 1099px) and (min-width: 769px) {
    .header-tools { grid-template-columns: 2.25rem 2.25rem; }
    .header-tool-button { padding: .35rem; }
    .header-tool-button > span { display: none; }
  }
  @media (max-width: 768px) {
    .header-tools { width: min(100%, 21rem); grid-template-columns: minmax(0, 1.65fr) minmax(5.6rem, 1fr); }
    .header-search-shortcut { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-tool-button { transition: none; }
  }
</style>

<script src="../../scripts/theme"></script>
