---
import { BILIBILI_URL, GITHUB_URL } from '../../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';

interface Props {
  showHeaderContacts?: boolean;
  compact?: boolean;
}

const { showHeaderContacts = false, compact = false } = Astro.props;
---

<div class:list={["social-links", { compact }]}>
  <HeaderLink class={compact ? 'compact-social-link' : undefined} href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
    <span class="sr-only">离子怪的 GitHub</span>
    <Icon name="github" />
  </HeaderLink>
  {showHeaderContacts && (
    <>
      <HeaderLink class={compact ? 'compact-social-link' : undefined} href={BILIBILI_URL} target="_blank" rel="noopener noreferrer">
        <span class="sr-only">离子怪的 Bilibili</span>
        <Icon name="bilibili" />
      </HeaderLink>
      <span class="social-placeholder" role="img" aria-label="QQ（暂未设置链接）" title="QQ 暂未设置链接">
        <Icon name="qq" />
      </span>
    </>
  )}
</div>

<style>
  .social-links {
    display: flex;
    justify-content: center;
    gap: 0.35em;
  }

  .social-placeholder {
    display: inline-flex;
    color: var(--foreground);
    opacity: 0.72;
    cursor: default;
  }

  .social-links.compact :global(a.compact-social-link),
  .social-links.compact .social-placeholder {
    box-sizing: border-box;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    padding: 2px;
  }
</style>
