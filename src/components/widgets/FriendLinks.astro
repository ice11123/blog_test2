---
interface FriendLink {
  url: string;
  image: string;
  name: string;
  description: string;
  label?: string;
}

interface Props {
  links: FriendLink[];
}

const { links } = Astro.props;
---

<div class="friend-links">
  {links.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="friend-card"
      aria-label={`访问${link.name}（在新标签页打开）`}
    >
      <span class="friend-avatar" aria-hidden="true">
        <img
          src={link.image}
          alt=""
          loading="lazy"
          decoding="async"
          width="64"
          height="64"
        />
      </span>
      <div class="friend-info">
        <span class="friend-label">{link.label ?? '友好站点'}</span>
        <span class="friend-name">{link.name}</span>
        <span class="friend-desc">{link.description}</span>
      </div>
      <span class="friend-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<style>
  .friend-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 14px;
    margin: 1.75rem 0;
  }

  .friend-card {
    position: relative;
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) 32px;
    align-items: center;
    gap: 14px;
    min-height: 112px;
    padding: 18px;
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl, 16px);
    background:
      radial-gradient(circle at 0 0, color-mix(in srgb, var(--accent) 9%, transparent), transparent 52%),
      var(--card-bg, var(--surface));
    text-decoration: none;
    color: inherit;
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
    transition: border-color 160ms var(--ease-out), box-shadow 160ms var(--ease-out), transform 120ms var(--ease-out);
  }

  .friend-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
  }

  .friend-card:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--focus, var(--accent)) 45%, transparent);
    outline-offset: 3px;
  }

  .friend-card:active { transform: scale(.985); }

  .friend-avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 1px solid color-mix(in srgb, var(--border-light) 75%, var(--accent));
    border-radius: 18px;
    background: var(--surface-subtle, var(--muted));
    box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .friend-avatar img {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    object-fit: cover;
  }

  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .friend-label {
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .friend-name {
    color: var(--text-primary, var(--foreground));
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.35;
  }

  .friend-desc {
    display: -webkit-box;
    color: var(--text-secondary, var(--foreground-dark));
    font-size: 0.78rem;
    line-height: 1.55;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .friend-arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-size: 0.92rem;
    line-height: 1;
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }

  @media (max-width: 640px) {
    .friend-links {
      grid-template-columns: 1fr;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .friend-card:hover {
      border-color: color-mix(in srgb, var(--accent) 55%, var(--border-light));
      box-shadow: 0 14px 32px rgba(17, 24, 39, 0.09);
      transform: translateY(-2px);
    }

    .friend-card:hover .friend-arrow {
      background: color-mix(in srgb, var(--accent) 16%, transparent);
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card, .friend-arrow { transition: none; }
    .friend-card:active { transform: none; }
  }
</style>
