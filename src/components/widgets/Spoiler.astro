---
import spoilerIcon from '/src/assets/icons/spoiler.svg?raw';

interface Props {
  hint?: string;
}

const { hint = '' } = Astro.props;
---

<span class="spoiler-wrapper" data-revealed="false">
  <button class="spoiler-overlay" type="button" aria-expanded="false">
    <span class="spoiler-overlay-inner">
      <span class="spoiler-icon" set:html={spoilerIcon}></span>
      {hint && <span class="spoiler-hint">{hint}</span>}
    </span>
  </button>
  <span class="spoiler-content">
    <slot />
  </span>
</span>

<style>
  .spoiler-wrapper {
    display: inline-block;
    position: relative;
    border-radius: 8px;
    vertical-align: baseline;
  }

  .spoiler-content {
    display: inline-block;
    filter: blur(8px);
    transition: filter 150ms var(--ease-out);
    user-select: none;
  }

  .spoiler-wrapper[data-revealed="true"] .spoiler-content {
    filter: blur(0);
    user-select: auto;
  }

  .spoiler-overlay {
    appearance: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    min-width: max-content;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: inherit;
    cursor: pointer;
    transition: opacity 150ms var(--ease-out), transform 100ms var(--ease-out);
  }

  .spoiler-wrapper[data-revealed="true"] .spoiler-overlay {
    opacity: 0;
    pointer-events: none;
  }

  .spoiler-overlay:active { transform: scale(.98); }
  .spoiler-overlay:focus-visible { outline: 2px solid var(--focus, var(--accent)); outline-offset: 3px; }

  .spoiler-overlay-inner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--fg-muted, #888);
  }

  .spoiler-icon {
    display: block;
    width: 32px;
    height: 32px;
    opacity: 0.6;
  }

  .spoiler-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .spoiler-hint {
    margin-top: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.7;
  }

  @media (hover: hover) and (pointer: fine) {
    .spoiler-wrapper:not([data-revealed="true"]):hover .spoiler-content { filter: blur(2px); }
    .spoiler-wrapper:not([data-revealed="true"]):hover .spoiler-overlay { opacity: .2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spoiler-content, .spoiler-overlay { transition: none; }
  }
</style>

<script>
  if (!(window as Window & { __spoilerBound?: boolean }).__spoilerBound) {
    (window as Window & { __spoilerBound?: boolean }).__spoilerBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const overlay = target?.closest<HTMLButtonElement>('.spoiler-overlay');
      const wrapper = overlay?.closest<HTMLElement>('.spoiler-wrapper');
      if (!overlay || !wrapper) return;
      wrapper.dataset.revealed = 'true';
      overlay.setAttribute('aria-expanded', 'true');
    });
  }
</script>
