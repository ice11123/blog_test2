---
import { SITE_AUTHOR, SITE_DESCRIPTION } from '../../consts';
import type { SidebarPost } from '../../lib/blogData';
import { computeSidebarStats, getSeriesPosts } from '../../lib/persistentSidebar';
import { blogPostPath, stripBase, withBase } from '../../lib/urls';
import '../../styles/persistent-sidebar.scss';
import SocialLinks from '../ui/SocialLinks.astro';

interface Props {
  posts: SidebarPost[];
  mode?: 'overview' | 'article';
  currentSlug?: string;
  currentDir1?: string;
  currentDir2?: string;
}

const {
  posts,
  mode = 'overview',
  currentSlug = '',
  currentDir1 = '',
  currentDir2 = '',
} = Astro.props;
const stats = computeSidebarStats(posts);
const currentPath = stripBase(Astro.url.pathname);
const seriesPosts = getSeriesPosts(posts, currentDir1, currentDir2);
const seriesLabel = currentDir2 || currentDir1 || '当前分类';
const isHome = currentPath === '/';
const isBlog = currentPath === '/blog/' || currentPath.startsWith('/blog/category/') || currentPath.startsWith('/blog/tag');
const isFriends = currentPath.startsWith('/friends');
const isAbout = currentPath.startsWith('/about');
---

<aside class="persistent-sidebar" data-persistent-sidebar data-mode={mode} aria-label="站点侧栏">
  <div class="persistent-sidebar-scroll">
    {mode === 'article' && (
      <div class="sidebar-segments" role="tablist" aria-label="侧栏内容">
        <button id="sidebar-tab-overview" type="button" role="tab" data-sidebar-tab="overview" aria-label="站点概览" aria-selected="false" aria-controls="sidebar-panel-overview" tabindex="-1">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13a8 8 0 1 1 16 0 8 8 0 0 1-16 0Z M12 13l4-4 M7.5 8.5l1 1 M16.5 17.5l-1-1" /></svg>
          <span>站点概览</span>
        </button>
        <button id="sidebar-tab-toc" type="button" role="tab" data-sidebar-tab="toc" aria-label="文章目录" aria-selected="true" aria-controls="sidebar-panel-toc" tabindex="0">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11 M9 12h11 M9 18h11 M4 6h.01 M4 12h.01 M4 18h.01" /></svg>
          <span>文章目录</span>
        </button>
        <button id="sidebar-tab-series" type="button" role="tab" data-sidebar-tab="series" aria-label="系列文章" aria-selected="false" aria-controls="sidebar-panel-series" tabindex="-1">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v16H6z M9 8h6 M9 12h6 M9 16h4" /></svg>
          <span>系列文章</span>
        </button>
      </div>
    )}

    <section id="sidebar-panel-overview" class="sidebar-panel-content overview-panel" role={mode === 'article' ? 'tabpanel' : undefined} aria-labelledby={mode === 'article' ? 'sidebar-tab-overview' : undefined} aria-label={mode === 'overview' ? '站点概览' : undefined} hidden={mode === 'article'}>
      <div class="sidebar-profile">
        <a class="profile-avatar" href={withBase('/')} aria-label={`${SITE_AUTHOR} 的博客首页`}>
          <img src={withBase('/avatar.jpg')} alt={`${SITE_AUTHOR}的头像`} width="120" height="120" loading="lazy" decoding="async" />
        </a>
        <strong>{SITE_AUTHOR}</strong>
        <p>{SITE_DESCRIPTION}</p>
        <SocialLinks showHeaderContacts compact />
      </div>

      <dl class="sidebar-stats" aria-label="站点统计">
        <div><dd>{stats.totalArticles}</dd><dt>文章</dt></div>
        <div><dd>{stats.totalCategories}</dd><dt>分类</dt></div>
        <div><dd>{stats.totalTags}</dd><dt>标签</dt></div>
      </dl>

      <nav class="sidebar-site-nav" aria-label="站点导航">
        <a class:list={['sidebar-nav-link', { active: isHome }]} href={withBase('/')} aria-current={isHome ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>首页</span>
        </a>
        <details class="sidebar-nav-group" open={isBlog || mode === 'article'}>
          <summary class:list={{ active: isBlog || mode === 'article' }}>
            <span class="nav-marker" aria-hidden="true"></span><span>文章</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
          </summary>
          <div class="sidebar-subnav">
            <a class:list={{ active: currentPath === '/blog/' }} href={withBase('/blog/')}>全部文章</a>
            <a class:list={{ active: currentPath.startsWith('/blog/tags') }} href={withBase('/blog/tags/')}>标签索引</a>
          </div>
        </details>
        <a class:list={['sidebar-nav-link', { active: isFriends }]} href={withBase('/friends/')} aria-current={isFriends ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>友链</span>
        </a>
        <a class:list={['sidebar-nav-link', { active: isAbout }]} href={withBase('/about/')} aria-current={isAbout ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>关于</span>
        </a>
      </nav>
    </section>

    {mode === 'article' && (
      <>
        <section id="sidebar-panel-toc" class="sidebar-panel-content toc-area" role="tabpanel" aria-labelledby="sidebar-tab-toc">
          <div class="position-indicator" aria-hidden="true"></div>
          <p class="panel-kicker">ON THIS PAGE</p>
          <ul id="toc-list"></ul>
        </section>
        <section id="sidebar-panel-series" class="sidebar-panel-content series-panel" role="tabpanel" aria-labelledby="sidebar-tab-series" hidden>
          <p class="panel-kicker">{seriesLabel}</p>
          {seriesPosts.length > 0 ? (
            <ol class="series-list">
              {seriesPosts.map((post) => (
                <li class:list={{ current: post.slug === currentSlug }}>
                  <a href={blogPostPath(post.slug)} aria-current={post.slug === currentSlug ? 'page' : undefined}>{post.title}</a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="sidebar-empty">当前文章没有可归组的分类系列。</p>
          )}
        </section>
      </>
    )}
  </div>
</aside>

<script src="../../scripts/persistent-sidebar"></script>
