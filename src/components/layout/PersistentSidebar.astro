---
import { SITE_AUTHOR, SITE_DESCRIPTION } from '../../consts';
import type { SidebarPost } from '../../lib/blogData';
import {
  buildArticleDirectory,
  buildTagDirectory,
  computeSidebarStats,
} from '../../lib/persistentSidebar';
import { blogPostPath, stripBase, withBase } from '../../lib/urls';
import '../../styles/persistent-sidebar.scss';
import SocialLinks from '../ui/SocialLinks.astro';

interface Props {
  posts: SidebarPost[];
  currentSlug?: string;
  currentDir1?: string;
  currentDir2?: string;
}

const {
  posts,
  currentSlug = '',
  currentDir1 = '',
  currentDir2 = '',
} = Astro.props;
const stats = computeSidebarStats(posts);
const articleDirectory = buildArticleDirectory(posts);
const tagDirectory = buildTagDirectory(posts);
const currentPath = stripBase(Astro.url.pathname);
const isHome = currentPath === '/';
const isBlog = currentPath === '/blog/' || currentPath.startsWith('/blog/');
const isFriends = currentPath.startsWith('/friends');
const isAbout = currentPath.startsWith('/about');
const initialTab = currentPath.startsWith('/blog/tag') ? 'tags' : isBlog ? 'catalog' : 'profile';

function decodePathPart(value = ''): string {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

const categoryMatch = currentPath.match(/^\/blog\/category\/([^/]+)(?:\/([^/]+))?/);
const activeDir1 = currentDir1 || decodePathPart(categoryMatch?.[1]);
const activeDir2 = currentDir2 || decodePathPart(categoryMatch?.[2]);
const tagMatch = currentPath.match(/^\/blog\/tag\/([^/]+)/);
const activeTag = decodePathPart(tagMatch?.[1]);
---

<aside class="persistent-sidebar" data-persistent-sidebar data-default-tab={initialTab} aria-label="站点侧栏">
  <div class="persistent-sidebar-scroll">
    <div class="sidebar-segments" role="tablist" aria-label="侧栏内容">
      <button id="sidebar-tab-profile" type="button" role="tab" data-sidebar-tab="profile" aria-label="个人" aria-selected={initialTab === 'profile' ? 'true' : 'false'} aria-controls="sidebar-panel-profile" tabindex={initialTab === 'profile' ? 0 : -1}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M4.5 21a7.5 7.5 0 0 1 15 0" /></svg>
        <span>个人</span>
      </button>
      <button id="sidebar-tab-catalog" type="button" role="tab" data-sidebar-tab="catalog" aria-label="目录" aria-selected={initialTab === 'catalog' ? 'true' : 'false'} aria-controls="sidebar-panel-catalog" tabindex={initialTab === 'catalog' ? 0 : -1}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11 M9 12h11 M9 18h11 M4 6h.01 M4 12h.01 M4 18h.01" /></svg>
        <span>目录</span>
      </button>
      <button id="sidebar-tab-tags" type="button" role="tab" data-sidebar-tab="tags" aria-label="标签目录" aria-selected={initialTab === 'tags' ? 'true' : 'false'} aria-controls="sidebar-panel-tags" tabindex={initialTab === 'tags' ? 0 : -1}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13 11 22l-9-9V4h9l9 9Z M7 8h.01" /></svg>
        <span>标签目录</span>
      </button>
    </div>

    <section id="sidebar-panel-profile" class="sidebar-panel-content profile-panel" role="tabpanel" aria-labelledby="sidebar-tab-profile" hidden={initialTab !== 'profile'}>
      <div class="sidebar-profile">
        <a class="profile-avatar" href={withBase('/')} aria-label={`${SITE_AUTHOR} 的博客首页`}>
          <img src={withBase('/avatar.jpg')} alt={`${SITE_AUTHOR}的头像`} width="120" height="120" loading="lazy" decoding="async" />
        </a>
        <strong>{SITE_AUTHOR}</strong>
        <p>{SITE_DESCRIPTION}</p>
        <SocialLinks showHeaderContacts compact />
      </div>

      <dl class="sidebar-stats" aria-label="站点统计">
        <div><dd>{stats.totalArticles}</dd><dt>文章</dt></div>
        <div><dd>{stats.totalCategories}</dd><dt>分类</dt></div>
        <div><dd>{stats.totalTags}</dd><dt>标签</dt></div>
      </dl>

      <nav class="sidebar-site-nav" aria-label="站点导航">
        <a class:list={['sidebar-nav-link', { active: isHome }]} href={withBase('/')} aria-current={isHome ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>首页</span>
        </a>
        <a class:list={['sidebar-nav-link', { active: isBlog }]} href={withBase('/blog/')} aria-current={currentPath === '/blog/' ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>文章</span>
        </a>
        <a class:list={['sidebar-nav-link', { active: isFriends }]} href={withBase('/friends/')} aria-current={isFriends ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>友链</span>
        </a>
        <a class:list={['sidebar-nav-link', { active: isAbout }]} href={withBase('/about/')} aria-current={isAbout ? 'page' : undefined}>
          <span class="nav-marker" aria-hidden="true"></span><span>关于</span>
        </a>
      </nav>
    </section>

    <section id="sidebar-panel-catalog" class="sidebar-panel-content catalog-panel" role="tabpanel" aria-labelledby="sidebar-tab-catalog" hidden={initialTab !== 'catalog'}>
      <div class="sidebar-panel-heading">
        <div><p>LIBRARY</p><h2>文章目录</h2></div>
        <span>{stats.totalArticles}</span>
      </div>
      <a class:list={['directory-all-link', { current: currentPath === '/blog/' }]} href={withBase('/blog/')} aria-current={currentPath === '/blog/' ? 'page' : undefined}>
        <span>全部文章</span><small>{stats.totalArticles}</small>
      </a>
      <nav class="article-directory" aria-label="全站文章目录">
        {articleDirectory.map((section) => (
          <details class="directory-group" open={section.name === activeDir1}>
            <summary>
              <span>{section.name}</span><small>{section.total}</small>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
            </summary>
            <div class="directory-group-body">
              {section.directPosts.map((post) => (
                <a class:list={{ current: post.slug === currentSlug }} href={blogPostPath(post.slug)} aria-current={post.slug === currentSlug ? 'page' : undefined}>{post.title}</a>
              ))}
              {section.subdirectories.map((subdirectory) => (
                <details class="directory-subgroup" open={section.name === activeDir1 && subdirectory.name === activeDir2}>
                  <summary><span>{subdirectory.name}</span><small>{subdirectory.posts.length}</small></summary>
                  <div>
                    {subdirectory.posts.map((post) => (
                      <a class:list={{ current: post.slug === currentSlug }} href={blogPostPath(post.slug)} aria-current={post.slug === currentSlug ? 'page' : undefined}>{post.title}</a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
        ))}
      </nav>
    </section>

    <section id="sidebar-panel-tags" class="sidebar-panel-content tags-panel" role="tabpanel" aria-labelledby="sidebar-tab-tags" hidden={initialTab !== 'tags'}>
      <div class="sidebar-panel-heading">
        <div><p>TOPICS</p><h2>标签目录</h2></div>
        <span>{stats.totalTags}</span>
      </div>
      <a class:list={['directory-all-link', { current: currentPath.startsWith('/blog/tags') }]} href={withBase('/blog/tags/')} aria-current={currentPath.startsWith('/blog/tags') ? 'page' : undefined}>
        <span>全部标签</span><small>{stats.totalTags}</small>
      </a>
      <nav class="tag-directory" aria-label="标签目录">
        {tagDirectory.map((tag) => (
          <a class:list={{ current: tag.name === activeTag }} href={withBase(`/blog/tag/${encodeURIComponent(tag.name)}/`)} aria-current={tag.name === activeTag ? 'page' : undefined}>
            <span>{tag.name}</span><small>{tag.count}</small>
          </a>
        ))}
      </nav>
    </section>
  </div>
</aside>

<script src="../../scripts/persistent-sidebar"></script>
