---
import { ADMIN_PASSWORD_HASH, ADMIN_UNLOCK_STORAGE_KEY, SITE_TITLE } from '../../consts';
import HeaderLink from '../ui/HeaderLink.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import HeaderTools from '../ui/HeaderTools.astro';
import { withBase } from '../../lib/urls';
---

<header id="site-header">
  <nav class="site-nav" aria-label="主导航">
    <div class="nav-brand">
      <HeaderLink id="site-title-link" href={withBase('/')} data-home-url={withBase('/')} data-admin-url={withBase('/admin/')} aria-label={`${SITE_TITLE}，连续点击 5 次打开管理入口`} title="连续点击 5 次打开管理入口">{SITE_TITLE}</HeaderLink>
    </div>
    <div class="nav-links">
      <HeaderLink href={withBase('/')}>主页</HeaderLink>
      <HeaderLink href={withBase('/blog/')}>博客</HeaderLink>
      <HeaderLink href={withBase('/friends/')}>友链</HeaderLink>
      <HeaderLink href={withBase('/about/')}>关于</HeaderLink>
    </div>
    <div class="nav-actions">
      <HeaderTools />
      <div id="header-social"><SocialLinks showHeaderContacts /></div>
    </div>
  </nav>
</header>

<dialog id="admin-password-dialog" aria-labelledby="admin-password-title">
  <form method="dialog" id="admin-password-form">
    <h2 id="admin-password-title">管理入口</h2>
    <p>请输入管理密码。此密码门槛仅用于前端原型，不提供真正的仓库权限保护。</p>
    <label for="admin-password-input">密码</label>
    <input id="admin-password-input" name="password" type="password" autocomplete="current-password" required />
    <p id="admin-password-error" class="admin-password-error" role="alert" hidden>密码不正确，或尚未配置密码哈希。</p>
    <div class="admin-password-actions">
      <button value="cancel" type="button" id="admin-password-cancel">取消</button>
      <button value="default" type="submit">进入管理</button>
    </div>
  </form>
</dialog>

<style>
  header { position: sticky; top: 0; z-index: 1000; width: 100%; box-sizing: border-box; padding: 20px 0 12px; background: color-mix(in srgb, var(--canvas) 88%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; }
  .site-nav { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; width: min(1200px, calc(100% - 48px)); margin: 0 auto; gap: 32px; }
  .nav-brand { min-width: 0; }
  .nav-brand :global(a) { padding: 0; color: var(--text-primary); font-size: 20px; font-weight: 750; letter-spacing: -.02em; }
  .nav-links { display: flex; align-items: center; gap: 24px; min-width: 0; }
  .nav-links :global(a) { position: relative; padding: 8px 0; color: var(--text-secondary); font-size: 16px; }
  .nav-links :global(a)::after { content: ''; position: absolute; left: 0; right: 0; bottom: 1px; height: 2px; border-radius: 999px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 160ms var(--ease-out); }
  .nav-links :global(a.active) { color: var(--text-primary); }
  .nav-links :global(a.active)::after { transform: scaleX(1); }
  .nav-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12px; min-width: 0; }
  #header-social :global(.social-links) { display: flex; align-items: center; gap: 4px; }
  #header-social :global(a), #header-social :global(.social-placeholder) { display: inline-flex; align-items: center; justify-content: center; padding: 8px; color: var(--text-secondary); border-radius: 8px; }
  #admin-password-dialog { width: min(360px, calc(100vw - 32px)); padding: 0; color: var(--text-primary); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
  #admin-password-dialog::backdrop { background: rgba(0,0,0,.45); backdrop-filter: blur(2px); }
  #admin-password-form { display: grid; gap: 12px; padding: 24px; }
  #admin-password-form h2, #admin-password-form p { margin: 0; }
  #admin-password-form p { color: var(--text-secondary); font-size: 14px; line-height: 1.5; }
  #admin-password-form label { font-size: 14px; }
  #admin-password-input { width: 100%; box-sizing: border-box; padding: 8px 12px; color: var(--text-primary); background: var(--canvas); border: 1px solid var(--border); border-radius: 8px; font: inherit; }
  #admin-password-input:focus-visible, .admin-password-actions button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .admin-password-error { color: var(--danger) !important; }
  .admin-password-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
  .admin-password-actions button { padding: 8px 12px; color: var(--text-primary); background: transparent; border: 1px solid var(--border); border-radius: 8px; font: inherit; cursor: pointer; }
  .admin-password-actions button:active { transform: scale(.97); }
  .admin-password-actions button[type="submit"] { color: var(--button-on-accent); background: var(--accent); border-color: var(--accent); }
  @media (max-width: 900px) {
    .site-nav { width: min(100% - 32px, 720px); }
    .site-nav { gap: 16px; }
    .nav-links { gap: 16px; }
  }
  @media (max-width: 999px) {
    header {
      background: color-mix(in srgb, var(--canvas) 97%, var(--surface) 3%);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  @media (max-width: 680px) {
    header { padding: 16px 0 8px; }
    .site-nav { width: calc(100% - 32px); }
    .site-nav { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'brand actions' 'links links'; gap: 8px 12px; }
    .nav-brand { grid-area: brand; overflow: hidden; }
    .nav-brand :global(a) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18px; }
    .nav-actions { grid-area: actions; gap: 4px; }
    .nav-actions :global(.header-tools) { width: auto; grid-template-columns: auto auto; gap: 4px; }
    .nav-actions :global(.header-tool-button) { width: 36px; min-height: 36px; padding: 8px; }
    .nav-actions :global(.header-tool-button > span:not(.icon)) { display: none; }
    .nav-actions :global(.header-search-shortcut) { display: none; }
    .nav-links { grid-area: links; width: 100%; overflow-x: auto; gap: 20px; scrollbar-width: none; }
    .nav-links::-webkit-scrollbar { display: none; }
    .nav-links :global(a) { flex: 0 0 auto; font-size: 14px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-brand :global(a:hover) { color: var(--accent); }
    .nav-links :global(a:hover) { color: var(--text-primary); }
    .nav-links :global(a:hover)::after { transform: scaleX(1); }
    #header-social :global(a:hover) { color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-links :global(a)::after, .admin-password-actions button { transition: none; }
  }
</style>

<script is:inline define:vars={{ ADMIN_PASSWORD_HASH, ADMIN_UNLOCK_STORAGE_KEY }}>
  const ADMIN_CLICK_LIMIT = 5;
  const ADMIN_CLICK_WINDOW = 5000;
  let adminClickCount = 0;
  let adminClickTimer;
  let adminAttempts = 0;
  async function sha256(value) {
    const data = new TextEncoder().encode(value);
    const digest = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
  }
  function openAdminDialog() {
    const dialog = document.querySelector('#admin-password-dialog');
    const input = document.querySelector('#admin-password-input');
    const error = document.querySelector('#admin-password-error');
    if (!dialog || !input) return;
    if (error) error.hidden = true;
    input.value = '';
    if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', '');
    input.focus();
  }
  function closeAdminDialog() {
    const dialog = document.querySelector('#admin-password-dialog');
    if (!dialog) return;
    if (typeof dialog.close === 'function') dialog.close(); else dialog.removeAttribute('open');
  }
  async function handleAdminSubmit(event) {
    event.preventDefault();
    const input = document.querySelector('#admin-password-input');
    const error = document.querySelector('#admin-password-error');
    if (!input || !error) return;
    const hash = await sha256(input.value);
    const valid = ADMIN_PASSWORD_HASH !== 'YOUR_ADMIN_PASSWORD_HASH_HERE' && hash === ADMIN_PASSWORD_HASH;
    if (!valid) {
      adminAttempts += 1;
      error.hidden = false;
      input.select();
      await new Promise(resolve => setTimeout(resolve, Math.min(adminAttempts * 150, 900)));
      return;
    }
    closeAdminDialog();
    sessionStorage.setItem(ADMIN_UNLOCK_STORAGE_KEY, 'true');
    const target = document.querySelector('#site-title-link')?.getAttribute('data-admin-url');
    if (target) window.location.assign(target);
  }
  function initAdminEntry() {
    const titleLink = document.querySelector('#site-title-link');
    const form = document.querySelector('#admin-password-form');
    const cancel = document.querySelector('#admin-password-cancel');
    if (titleLink && titleLink.dataset.adminBound !== 'true') {
      titleLink.dataset.adminBound = 'true';
      titleLink.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const homeUrl = new URL(titleLink.dataset.homeUrl || titleLink.href, window.location.href);
        const normalizePath = (value) => value.replace(/\/+$/, '') || '/';
        if (normalizePath(window.location.pathname) !== normalizePath(homeUrl.pathname)) {
          adminClickCount = 0;
          if (adminClickTimer) clearTimeout(adminClickTimer);
          return;
        }
        event.preventDefault();
        const now = Date.now();
        if (!adminClickTimer || now - (Number(titleLink.dataset.lastAdminClick) || 0) > ADMIN_CLICK_WINDOW) adminClickCount = 0;
        titleLink.dataset.lastAdminClick = String(now);
        adminClickCount += 1;
        if (adminClickTimer) clearTimeout(adminClickTimer);
        adminClickTimer = setTimeout(() => { adminClickCount = 0; }, ADMIN_CLICK_WINDOW);
        if (adminClickCount >= ADMIN_CLICK_LIMIT) { adminClickCount = 0; openAdminDialog(); return; }
      });
    }
    if (form && form.dataset.bound !== 'true') {
      form.dataset.bound = 'true';
      form.addEventListener('submit', (event) => { void handleAdminSubmit(event); });
    }
    if (cancel && cancel.dataset.bound !== 'true') {
      cancel.dataset.bound = 'true';
      cancel.addEventListener('click', closeAdminDialog);
    }
  }
  document.addEventListener('DOMContentLoaded', initAdminEntry);
  document.addEventListener('astro:page-load', initAdminEntry);
</script>
