---
import '../../styles/article-toc-sidebar.scss';
---

<aside
  id="article-toc-sidebar"
  class="article-toc-sidebar"
  data-article-toc-sidebar
  data-scroll-start="true"
  data-scroll-end="true"
  aria-label="当前文章目录"
>
  <div class="article-toc-scroll toc-area" tabindex="0" aria-label="文章目录滚动区域">
    <div class="position-indicator" aria-hidden="true"></div>
    <p class="article-toc-kicker">ON THIS PAGE</p>
    <h2>文章目录</h2>
    <ul id="toc-list"></ul>
  </div>
  <span class="article-toc-scroll-fade article-toc-scroll-fade-top" aria-hidden="true"></span>
  <span class="article-toc-scroll-fade article-toc-scroll-fade-bottom" aria-hidden="true"></span>
</aside>
