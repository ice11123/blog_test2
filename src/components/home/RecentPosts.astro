---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../blog/FormattedDate.astro';
import { blogPostPath, withBase } from '../../lib/urls';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="recent-section" aria-labelledby="recent-title">
  <header class="section-heading">
    <div>
      <p class="section-kicker">RECENT WRITING</p>
      <h2 id="recent-title">近期文章</h2>
    </div>
    <a class="section-link" href={withBase('/blog/')}>查看全部文章 <span aria-hidden="true">→</span></a>
  </header>

  {posts.length > 0 ? (
    <div class="recent-list" data-count={posts.length}>
      {posts.map((post, index) => (
        <article class="home-post-card">
          <a class="home-post-link" href={blogPostPath(post.id)}>
            <div class="home-post-media">
              {post.data.heroImage ? (
                <Image src={post.data.heroImage} width={192} height={192} alt="" loading="lazy" />
              ) : (
                <span class="home-post-sequence" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              )}
            </div>
            <div class="home-post-copy">
              <div class="post-meta-line">
                <span>{post.data.dir1 || '未分类'}</span>
                <time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description.replace(/<[^>]+>/g, '')}</p>
              <div class="post-footer">
                <div class="post-tags" aria-label="文章标签">
                  {post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}
                </div>
                <span class="post-more" aria-hidden="true">↗</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  ) : (
    <div class="home-empty">
      <strong>文章正在整理中</strong>
      <p>这里会展示最近发布的内容。你也可以先进入博客列表查看分类结构。</p>
      <a href={withBase('/blog/')}>浏览博客</a>
    </div>
  )}
</section>

<style>
  .recent-section { padding: 0 0 40px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  .section-kicker { margin: 0 0 12px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  .section-heading h2 { margin: 0; color: var(--text-primary); font-size: 28px; line-height: 1.25; }
  .section-link { color: var(--accent); font-size: 14px; font-weight: 650; }
  .section-link:focus-visible, .home-post-link:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .recent-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .home-post-card { min-width: 0; overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
  .home-post-link { display: grid; grid-template-columns: 48px minmax(0, 1fr); align-items: start; gap: 16px; height: 100%; padding: 22px; box-sizing: border-box; color: inherit; text-decoration: none; }
  .home-post-media { position: relative; width: 48px; height: 64px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--border) 65%, transparent); border-radius: 10px; background: var(--surface-subtle); }
  .home-post-media :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 0; transition: transform 220ms cubic-bezier(.23,1,.32,1); }
  .home-post-sequence { display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent); font-size: 12px; font-weight: 750; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
  .home-post-copy { display: flex; flex-direction: column; min-width: 0; height: 100%; }
  .post-meta-line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; color: var(--text-secondary); font-size: 11px; line-height: 1.5; }
  .post-meta-line > span { color: var(--accent); font-weight: 650; overflow-wrap: anywhere; }
  .post-meta-line time { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .home-post-copy h3 { margin: 9px 0 0; color: var(--text-primary); font-size: 17px; line-height: 1.5; overflow-wrap: anywhere; text-wrap: pretty; }
  .home-post-copy > p { display: -webkit-box; overflow: hidden; margin: 8px 0 0; color: var(--text-secondary); font-size: 13px; line-height: 1.7; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .post-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; padding-top: 14px; }
  .post-tags { display: flex; flex-wrap: wrap; min-width: 0; gap: 6px; }
  .post-tags span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 2px 7px; color: var(--text-secondary); background: var(--surface-subtle); border-radius: 5px; font-size: 11px; }
  .post-more { flex-shrink: 0; color: var(--accent); font-size: 19px; font-weight: 650; }
  .home-empty { padding: 32px; color: var(--text-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .home-empty strong { color: var(--text-primary); font-size: 20px; }
  .home-empty p { margin: 8px 0 16px; font-size: 16px; }

  @media (hover: hover) and (pointer: fine) {
    .home-post-card { transition: transform 180ms cubic-bezier(.23,1,.32,1), border-color 180ms ease, box-shadow 180ms ease; }
    .home-post-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: 0 12px 32px color-mix(in srgb, var(--text-primary) 9%, transparent); }
    .home-post-card:hover .home-post-media :global(img) { transform: scale(1.025); }
  }

  @media (max-width: 900px) {
    .home-post-link { grid-template-columns: 48px minmax(0, 1fr); gap: 14px; padding: 20px; }
    .home-post-media { width: 48px; height: 64px; }
  }

  @media (min-width: 1280px) {
    .recent-list[data-count='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .recent-list[data-count='3'] .home-post-link { display: block; position: relative; }
    .recent-list[data-count='3'] .home-post-media { position: absolute; top: 20px; right: 20px; width: 30px; height: 30px; border-radius: 7px; }
    .recent-list[data-count='3'] .post-meta-line { padding-right: 42px; }
    .recent-list[data-count='3'] .home-post-copy h3 { margin-top: 16px; }
  }

  @media (max-width: 640px) {
    .recent-section { padding-bottom: 32px; }
    .section-heading { align-items: flex-start; }
    .section-heading h2 { font-size: 24px; }
    .section-link { align-self: end; flex-shrink: 0; margin: 0; font-size: 12px; }
    .recent-list { grid-template-columns: 1fr; gap: 12px; }
    .home-post-link { display: block; position: relative; padding: 18px; }
    .home-post-media { position: absolute; top: 18px; right: 18px; width: 28px; height: 28px; border-radius: 6px; }
    .post-meta-line { padding-right: 38px; }
    .home-post-copy h3 { margin-top: 16px; font-size: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-post-card, .home-post-media :global(img) { transition-duration: 0ms; }
  }
</style>
