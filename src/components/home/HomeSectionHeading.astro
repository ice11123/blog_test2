---
interface Props { id: string; title: string; eyebrow: string; description?: string }
const { id, title, eyebrow, description } = Astro.props;
---

<header class="home-section-heading">
  <div><p>{eyebrow}</p><h2 id={id}>{title}</h2></div>
  {description && <p class="home-section-description">{description}</p>}
  <slot />
</header>

<style>
  .home-section-heading { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; margin-bottom: 24px; }
  .home-section-heading > div > p { margin: 0 0 12px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  .home-section-heading h2 { margin: 0; color: var(--text-primary); font-size: 28px; line-height: 1.25; }
  .home-section-description { max-width: 420px; margin: 0; color: var(--text-secondary); font-size: 13px; line-height: 1.75; text-align: right; }
  @media (max-width: 640px) {
    .home-section-heading { gap: 12px 20px; margin-bottom: 20px; }
    .home-section-heading h2 { font-size: 24px; }
    .home-section-description { flex-basis: 100%; max-width: none; font-size: 12px; text-align: left; }
  }
</style>
