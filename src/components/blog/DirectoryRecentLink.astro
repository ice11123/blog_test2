---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { blogPostPath } from '../../lib/urls';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const plainDescription = post.data.description.replace(/<[^>]+>/g, '').trim();
---

<li class="directory-recent-item">
  <a class="directory-recent-link" href={blogPostPath(post.id)}>
    <span class="directory-recent-dot" aria-hidden="true"></span>
    <span class="directory-recent-copy">
      <strong>{post.data.title}</strong>
      <span>{plainDescription}</span>
    </span>
    <time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
    <span class="directory-recent-arrow" aria-hidden="true">↗</span>
  </a>
</li>

<style>
  .directory-recent-item {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directory-recent-item + .directory-recent-item {
    border-top: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
  }

  .directory-recent-link {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr) auto 1.5rem;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    padding: 0.92rem 0;
    color: inherit;
    text-decoration: none;
    transition:
      color 160ms var(--ease-out),
      transform 120ms var(--ease-out);
  }

  .directory-recent-link:active {
    transform: scale(0.997);
  }

  .directory-recent-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--directory-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--directory-accent) 10%, transparent);
  }

  .directory-recent-copy {
    min-width: 0;
  }

  .directory-recent-copy strong,
  .directory-recent-copy > span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-recent-copy strong {
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 670;
  }

  .directory-recent-copy > span {
    margin-top: 0.3rem;
    color: var(--gray);
    font-size: 0.75rem;
  }

  time {
    color: var(--gray);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .directory-recent-arrow {
    color: var(--directory-accent);
    transition: transform 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .directory-recent-link:hover .directory-recent-copy strong {
      color: var(--directory-accent);
    }

    .directory-recent-link:hover .directory-recent-arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 680px) {
    .directory-recent-link {
      grid-template-columns: 0.45rem minmax(0, 1fr) 1.25rem;
      gap: 0.65rem;
    }

    time {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .directory-recent-link,
    .directory-recent-arrow {
      transition: none;
    }

    .directory-recent-link:active,
    .directory-recent-link:hover .directory-recent-arrow {
      transform: none;
    }
  }
</style>
