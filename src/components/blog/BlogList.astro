---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';
import DirectoryCategoryHeader from './DirectoryCategoryHeader.astro';
import DirectoryPostRow from './DirectoryPostRow.astro';
import DirectoryRecentLink from './DirectoryRecentLink.astro';
import { resolveDirs } from '../../lib/utils';
import { blogCategoryPath } from '../../lib/urls';
import { compareDirectoryPostMetadata } from '../../lib/postOrdering';

interface Props {
  sort?: 'time' | 'oldest' | 'dir' | 'overview';
  dirOrder?: {
    dir1: string[];
    dir2: Record<string, string[]>;
  };
  posts?: CollectionEntry<'blog'>[];
}

const { sort = 'time', dirOrder = { dir1: [], dir2: {} }, posts: externalPosts } = Astro.props;
let posts = externalPosts ?? await getCollection('blog');

posts = posts.map(post => ({ ...post, data: { ...post.data, ...resolveDirs(post) } }));

function sortDirectoryPosts(list: CollectionEntry<'blog'>[]): CollectionEntry<'blog'>[] {
  return list.sort((a, b) => compareDirectoryPostMetadata(
    a.data.title,
    a.data.pubDate,
    b.data.title,
    b.data.pubDate,
  ));
}

if (sort === 'time') {
  posts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
}
if (sort === 'oldest') {
  posts = sortDirectoryPosts(posts);
}

let orderedData: Array<[string, Array<[string, CollectionEntry<'blog'>[]]>]> = [];

function resolveCategoryVisual(name: string, index: number): 'window' | 'network' | 'circuit' | 'power' | 'library' {
  if (/AI|Agent/i.test(name)) return 'network';
  if (/电控|控制|嵌入式/.test(name)) return 'circuit';
  if (/电源|功率/.test(name)) return 'power';
  if (/博客|演示|站点/.test(name)) return 'window';
  return index % 2 === 0 ? 'library' : 'window';
}

if (sort === 'dir' || sort === 'overview') {
  const grouped: Record<string, Record<string, CollectionEntry<'blog'>[]>> = {};
  for (const post of posts) {
    const d1 = post.data.dir1 || '未分类';
    const d2 = post.data.dir2 || '';
    grouped[d1] ??= {};
    grouped[d1][d2] ??= [];
    grouped[d1][d2].push(post);
  }

  // 只有总目录需要展示尚无文章的预设一级分类；进入某个分类后应只呈现当前分组。
  if (sort === 'overview') {
    for (const dir1 of dirOrder.dir1) grouped[dir1] ??= {};
  }

  const finalOrder: typeof orderedData = [];

  const orderedDir1 = [
    ...dirOrder.dir1.filter(d1 => grouped[d1]),
    ...Object.keys(grouped).filter(d1 => !dirOrder.dir1.includes(d1)).sort((a, b) => a.localeCompare(b)),
  ];

  for (const d1 of orderedDir1) {
    if (!grouped[d1]) continue;
    const dir2Map = grouped[d1];
    const dir2List: Array<[string, CollectionEntry<'blog'>[]]> = [];

    // 1. 先渲染你配置的 dir2
    const expectedDir2 = dirOrder.dir2[d1] || [];
    for (const d2 of expectedDir2) {
      if (dir2Map[d2]) {
        const sortedPosts = sortDirectoryPosts(dir2Map[d2]);
        dir2List.push([d2, sortedPosts]);
      }
    }

    // 2. 自动渲染没有二级目录的文章（dir2 = ""）
    if (dir2Map[""]) {
      const sortedPosts = sortDirectoryPosts(dir2Map[""]);
      dir2List.push(["", sortedPosts]);
    }

    // 3. 渲染未在配置中的其他二级目录
    for (const d2 of Object.keys(dir2Map)) {
      if (d2 === "" || expectedDir2.includes(d2)) continue;
      const sortedPosts = sortDirectoryPosts(dir2Map[d2]);
      dir2List.push([d2, sortedPosts]);
    }

    finalOrder.push([d1, dir2List]);
  }

  orderedData = finalOrder;
}
---

<style>
  .card-grid {
    margin: 8px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    place-items: center; /* 单个元素时自动居中 */
    gap: 20px;
    list-style: none;
    padding: 0;
  }

  .blog-list,
  .directory-groups {
    min-width: 0;
  }

  .directory-groups {
    display: grid;
    gap: 1.6rem;
    margin-top: 1.75rem;
  }

  .directory-section {
    --directory-accent: var(--accent-light);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    box-shadow: 0 16px 42px color-mix(in srgb, var(--text) 5%, transparent);
  }

  .directory-section[data-visual='network'] {
    --directory-accent: #6574b8;
  }

  .directory-section[data-visual='library'] {
    --directory-accent: #397f70;
  }

  .directory-section[data-visual='circuit'] {
    --directory-accent: #287f83;
  }

  .directory-section[data-visual='power'] {
    --directory-accent: #c8753f;
  }

  :global([data-theme='dark']) .directory-section[data-visual='network'] {
    --directory-accent: #aeb9ff;
  }

  :global([data-theme='dark']) .directory-section[data-visual='library'] {
    --directory-accent: #83cab9;
  }

  :global([data-theme='dark']) .directory-section[data-visual='circuit'] {
    --directory-accent: #73cbc9;
  }

  :global([data-theme='dark']) .directory-section[data-visual='power'] {
    --directory-accent: #f0a36d;
  }

  .directory-subsection + .directory-subsection {
    border-top: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
  }

  .directory-subsection-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.78rem 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--directory-accent) 16%, var(--border));
    background: color-mix(in srgb, var(--directory-accent) 5%, var(--surface));
  }

  .directory-subsection-title {
    display: flex;
    align-items: center;
    gap: 0.68rem;
    min-width: 0;
  }

  .directory-branch-mark {
    position: relative;
    display: block;
    flex: none;
    width: 1.45rem;
    height: 1.45rem;
    border: 1px solid color-mix(in srgb, var(--directory-accent) 32%, transparent);
    border-radius: 7px;
    background: color-mix(in srgb, var(--directory-accent) 9%, transparent);
  }

  .directory-branch-mark::before,
  .directory-branch-mark::after {
    position: absolute;
    background: var(--directory-accent);
    content: '';
    opacity: 0.78;
  }

  .directory-branch-mark::before {
    top: 0.35rem;
    left: 0.43rem;
    width: 1px;
    height: 0.68rem;
  }

  .directory-branch-mark::after {
    top: 0.72rem;
    left: 0.43rem;
    width: 0.52rem;
    height: 1px;
  }

  .directory-subsection-label {
    margin: 0 0 0.1rem;
    color: var(--directory-accent);
    font-size: 0.58rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    line-height: 1.15;
  }

  .directory-subsection h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 720;
    letter-spacing: 0.01em;
  }

  .directory-subsection-count {
    flex: none;
    color: var(--gray);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .directory-post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directory-overview-body {
    padding: 0.15rem 1.5rem 0.5rem;
  }

  .directory-overview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0 0.65rem;
    color: var(--gray);
    font-size: 0.72rem;
  }

  .directory-overview-heading strong {
    color: var(--text);
    font-size: 0.76rem;
    font-weight: 680;
    letter-spacing: 0.04em;
  }

  .directory-overview-heading a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--directory-accent);
    font-weight: 680;
    text-decoration: none;
  }

  .directory-overview-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directory-overview-empty {
    margin: 0;
    padding: 1rem 0 1.25rem;
    color: var(--gray);
    font-size: 0.82rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .directory-overview-heading a:hover {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  @media (max-width: 680px) {
    .directory-groups {
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .directory-section {
      border-radius: 15px;
    }

    .directory-subsection-header {
      padding: 0.7rem 1rem;
    }

    .directory-overview-body {
      padding-inline: 1rem;
    }
  }
</style>

<main class="blog-list">
  {sort === 'time' || sort === 'oldest' ? (
    <ul class="card-grid">
      {posts.map((post) => <BlogCard post={post} />)}
    </ul>
  ) : (
    <div class="directory-groups">
      {orderedData.map(([dir1, dir2List], index) => {
        const categoryIndex = dirOrder.dir1.indexOf(dir1);
        const displayIndex = categoryIndex >= 0 ? categoryIndex : index;
        const categoryHref = blogCategoryPath(dir1);
        const categoryPosts = dir2List
          .flatMap(([, list]) => list)
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
        const recentPosts = categoryPosts.slice(0, 3);

        return (
        <section
          class="directory-section"
          data-visual={resolveCategoryVisual(dir1, displayIndex)}
          aria-labelledby={`directory-section-${displayIndex}`}
        >
          <DirectoryCategoryHeader
            id={`directory-section-${displayIndex}`}
            title={dir1}
            count={categoryPosts.length}
            index={displayIndex}
            visual={resolveCategoryVisual(dir1, displayIndex)}
            href={sort === 'overview' ? categoryHref : undefined}
          />
          {sort === 'overview' ? (
            <div class="directory-overview-body">
              <div class="directory-overview-heading">
                <strong>近期更新</strong>
                <a href={categoryHref}>查看完整分类 <span aria-hidden="true">→</span></a>
              </div>
              {recentPosts.length > 0 ? (
                <ul class="directory-overview-list">
                  {recentPosts.map((post) => <DirectoryRecentLink post={post} />)}
                </ul>
              ) : (
                <p class="directory-overview-empty">这个分类还没有文章。</p>
              )}
            </div>
          ) : dir2List.map(([dir2, list]) => (
            <section class="directory-subsection" aria-label={dir2 || `${dir1}文章`}>
              <header class="directory-subsection-header">
                <div class="directory-subsection-title">
                  <span class="directory-branch-mark" aria-hidden="true"></span>
                  <div>
                    <p class="directory-subsection-label">二级分类</p>
                  <h3>{dir2 || '未归入二级分类'}</h3>
                  </div>
                </div>
                <span class="directory-subsection-count">{list.length} 篇</span>
              </header>
              <ul class="directory-post-list">
                {list.map((post, postIndex) => <DirectoryPostRow post={post} index={postIndex} />)}
              </ul>
            </section>
          ))}
        </section>
        );
      })}
    </div>
  )}
</main>
