---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';
import DirectoryPostRow from './DirectoryPostRow.astro';
import { resolveDirs } from '../../lib/utils';

interface Props {
  sort?: 'time' | 'dir';
  dirOrder?: {
    dir1: string[];
    dir2: Record<string, string[]>;
  };
  posts?: CollectionEntry<'blog'>[];
}

const { sort = 'time', dirOrder = { dir1: [], dir2: {} }, posts: externalPosts } = Astro.props;
let posts = externalPosts ?? await getCollection('blog');

posts = posts.map(post => ({ ...post, data: { ...post.data, ...resolveDirs(post) } }));

if (sort === 'time') {
  posts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
}

let orderedData: Array<[string, Array<[string, CollectionEntry<'blog'>[]]>]> = [];

if (sort === 'dir') {
  const grouped: Record<string, Record<string, CollectionEntry<'blog'>[]>> = {};
  for (const post of posts) {
    const d1 = post.data.dir1 || '未分类';
    const d2 = post.data.dir2 || '';
    grouped[d1] ??= {};
    grouped[d1][d2] ??= [];
    grouped[d1][d2].push(post);
  }

  const finalOrder: typeof orderedData = [];

  const orderedDir1 = [
    ...dirOrder.dir1.filter(d1 => grouped[d1]),
    ...Object.keys(grouped).filter(d1 => !dirOrder.dir1.includes(d1)).sort((a, b) => a.localeCompare(b)),
  ];

  for (const d1 of orderedDir1) {
    if (!grouped[d1]) continue;
    const dir2Map = grouped[d1];
    const dir2List: Array<[string, CollectionEntry<'blog'>[]]> = [];

    // 1. 先渲染你配置的 dir2
    const expectedDir2 = dirOrder.dir2[d1] || [];
    for (const d2 of expectedDir2) {
      if (dir2Map[d2]) {
        const sortedPosts = dir2Map[d2].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
        dir2List.push([d2, sortedPosts]);
      }
    }

    // 2. 自动渲染没有二级目录的文章（dir2 = ""）
    if (dir2Map[""]) {
      const sortedPosts = dir2Map[""].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
      dir2List.push(["", sortedPosts]);
    }

    // 3. 渲染未在配置中的其他二级目录
    for (const d2 of Object.keys(dir2Map)) {
      if (d2 === "" || expectedDir2.includes(d2)) continue;
      const sortedPosts = dir2Map[d2].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
      dir2List.push([d2, sortedPosts]);
    }

    finalOrder.push([d1, dir2List]);
  }

  orderedData = finalOrder;
}
---

<style>
  .card-grid {
    margin: 8px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    place-items: center; /* 单个元素时自动居中 */
    gap: 20px;
    list-style: none;
    padding: 0;
  }

  .blog-list,
  .directory-groups {
    min-width: 0;
  }

  .directory-groups {
    display: grid;
    gap: 1.6rem;
    margin-top: 1.75rem;
  }

  .directory-section {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    box-shadow: 0 16px 42px color-mix(in srgb, var(--text) 5%, transparent);
  }

  .directory-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 1.5rem 1.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent-light) 7%, transparent), transparent 58%);
  }

  .directory-eyebrow {
    margin: 0 0 0.28rem;
    color: var(--accent-light);
    font-size: 0.67rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .directory-section h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.2rem, 2vw, 1.48rem);
    line-height: 1.3;
  }

  .directory-section-count,
  .directory-subsection-count {
    flex: none;
    color: var(--gray);
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .directory-subsection + .directory-subsection {
    border-top: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
  }

  .directory-subsection-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.5rem 0.2rem;
  }

  .directory-subsection h3 {
    margin: 0;
    color: var(--gray);
    font-size: 0.78rem;
    font-weight: 680;
    letter-spacing: 0.04em;
  }

  .directory-post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 680px) {
    .directory-groups {
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .directory-section {
      border-radius: 15px;
    }

    .directory-section-header {
      align-items: center;
      padding: 1.05rem 1rem 0.9rem;
    }

    .directory-subsection-header {
      padding: 0.7rem 1rem 0.15rem;
    }
  }
</style>

<main class="blog-list">
  {sort === 'time' ? (
    <ul class="card-grid">
      {posts.map((post) => <BlogCard post={post} />)}
    </ul>
  ) : (
    <div class="directory-groups">
      {orderedData.map(([dir1, dir2List], index) => (
        <section class="directory-section" aria-labelledby={`directory-section-${index}`}>
          <header class="directory-section-header">
            <div>
              <p class="directory-eyebrow">Collection</p>
              <h2 id={`directory-section-${index}`}>{dir1}</h2>
            </div>
            <span class="directory-section-count">
              {dir2List.reduce((count, [, list]) => count + list.length, 0)} 篇
            </span>
          </header>
          {dir2List.map(([dir2, list]) => (
            <section class="directory-subsection" aria-label={dir2 || `${dir1}文章`}>
              {dir2 && (
                <header class="directory-subsection-header">
                  <h3>{dir2}</h3>
                  <span class="directory-subsection-count">{list.length} 篇</span>
                </header>
              )}
              <ul class="directory-post-list">
                {list.map((post) => <DirectoryPostRow post={post} />)}
              </ul>
            </section>
          ))}
        </section>
      ))}
    </div>
  )}
</main>
